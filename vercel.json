{
  "buildCommand": "prisma generate && (prisma db push || echo 'DB push skipped') && next build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/support-sync",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/meet-transcripts",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/pulse-reconcile",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/care-digest",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/analytics-snapshot",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/embed-conversations",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/auto-archive-tasks",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/pulse-run-monitors",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/docs-gdrive-backup",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/wiki-monitors",
      "schedule": "0 1 * * *"
    }
  ]
}
