generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum DocumentType {
  PROPOSAL // Project pitch / scope / costing
  SLA // Service Level Agreement
  SOW // Statement of Work (typically under a parent MSA)
  MSA // Master Service Agreement
  NDA // Non-Disclosure Agreement
  CO // Change Order (against a SOW)
  DSA // Data Sharing Agreement / DPA (GDPR Article 28)
  HANDOVER // End-of-project handover — lightweight, client-facing wrap-up
  REPORT // Status report / recurring progress update
  BRIEF // Meeting notes / short brief — context, decisions, actions
  OTHER // Blank / freeform document
}

enum DocumentStatus {
  DRAFT
  PRODUCT_SIGN_OFF
  TECH_SIGN_OFF
  IN_REVIEW
  APPROVED
  SENT
  ACCEPTED // Client accepted the document via the public /docs/[token] page (the "won" signal)
  DECLINED // Client explicitly declined via the public page (the "lost" signal)
  ARCHIVED
}

enum TimelineView {
  LIST
  MILESTONE
}

enum CostKind {
  ONE_OFF
  RECURRING
}

enum AssetType {
  COVER_IMAGE
  SECTION_GRAPHIC
  DIAGRAM
  LOGO
  SCREENSHOT
}

enum AssetSize {
  SMALL
  MEDIUM
  LARGE
  FULL
}

enum AssetAlignment {
  LEFT
  CENTER
  RIGHT
  FULL
}

enum LinkType {
  INTERNAL_ROUTE
  EXTERNAL_URL
  DECK_LINK
  DOCUMENT_LINK
  EMAIL_LINK
}

enum CTARole {
  PRIMARY
  SECONDARY
}

enum ExportFormat {
  PRINT
  PDF
  SHARE_LINK
}

enum ExportStatus {
  PENDING
  READY
  FAILED
}

enum RateBillingPeriod {
  DAY
  WEEK
  MONTH
}

enum PipelineStatus {
  SOURCED
  INVITED
  ASSESSMENT_IN_PROGRESS
  CODECLEAR_COMPLETE
  PLACED
  RECHECK_DUE
}

enum IdentityConfidence {
  HIGH
  MEDIUM
  LOW
  PENDING
}

enum CodeClearTier {
  TIER_1
  TIER_2
  TIER_3
}

/// Candidate origin — gates Gitwork-team devs from externally sourced devs that
/// will eventually live in a marketplace catalogue. Defaults to INTERNAL so the
/// existing 21 devs auto-tag correctly on migration.
enum CandidateOrigin {
  INTERNAL
  EXTERNAL
}

enum CandidateAvailability {
  AVAILABLE
  ENGAGED
  UNAVAILABLE
}

/// Organisational grouping for the developer roster — purely UI/cost filtering.
/// BENCH is the commercial roster (default — what shows up in costings).
/// PRO_BONO covers devs who work with Gitwork off-billing (excluded from
/// cost rollups, shown in a separate section on the Developers list).
/// Add more values here as new categories arrive (TRAINEE, ALUMNI, etc.).
enum CandidateDevGroup {
  BENCH
  PRO_BONO
}

/// Mirrors PulseCheckStatus — the validation engine and the project-health engine
/// share the same PASS/WARN/FAIL/SKIPPED vocabulary.
enum CodeClearCheckStatus {
  PASS
  WARN
  FAIL
  SKIPPED
}

enum GitHubAnalysisStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum GitHubAnalysisTriggerSource {
  MANUAL
  PLACEMENT
}

/// PROFILE = scan a dev's whole GitHub profile (the default validation).
/// REPO    = scan a specific repo for this dev's contributions, optionally
///           filtered to paths they own. Used when a dev is engaged with a
///           client whose platform has a repoUrl.
enum GitHubAnalysisScope {
  PROFILE
  REPO
}

model User {
  id                        String                  @id @default(cuid())
  email                     String                  @unique
  name                      String?
  avatarUrl                 String?
  passwordHash              String?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  memberships               WorkspaceMember[]
  documents                 Document[]              @relation("DocumentOwner")
  invitesSent               WorkspaceInvite[]       @relation("InvitesSent")
  invitesAccepted           WorkspaceInvite[]       @relation("InvitesAccepted")
  proofDocuments            ProofDocument[]
  signatureRequestsCreated  SignatureRequest[]      @relation("SignatureRequestCreator")
  deviceTokens              DeviceToken[]
  triggeredPulseScans       PulseScan[]             @relation("PulseScanTriggeredBy")
  notificationPreference    NotificationPreference?
  notifications             Notification[]
  auditLogEntries           AuditLog[]
  meetingSummariesGenerated MeetingSummary[]        @relation("MeetingSummaryGenerator")
  meetingsOwned             Meeting[]               @relation("MeetingOwner")
  leaveRequests             LeaveRequest[]          @relation("LeaveRequester")
  leaveRequestsApproved     LeaveRequest[]          @relation("LeaveApprover")
  expensesSubmitted         Expense[]               @relation("ExpenseClaimant")
  expensesReviewed          Expense[]               @relation("ExpenseReviewer")
  clientAssignments         ClientAssignment[]
  tasksAssigned             Task[]                  @relation("TaskAssignee")
  assignedTasks             Task[]                  @relation("TaskAssignees")
  tasksCreated              Task[]                  @relation("TaskCreator")
  designSystemsUpdated      ClientDesignSystem[]    @relation("DesignSystemUpdatedBy")
  taskComments              TaskComment[]
  dailyUpdates              DailyUpdate[]
  slackUpdateLogs           SlackUpdateLog[]
  // MCP / OAuth (Phase 3) — Foundry as an OAuth 2.1 authorization server.
  oauthAuthCodes            OAuthAuthCode[]
  oauthTokens               OAuthToken[]
  mcpConnections            McpConnection[]
  deskReminders             DeskReminder[]
  broadcastsCreated         Broadcast[]             @relation("BroadcastCreator")
  handbookArticles          HandbookArticle[]       @relation("HandbookAuthor")
  // Per-user Google OAuth refresh token. Captured on sign-in. Drives the personal dashboard
  // widgets (Calendar, Gmail, Meeting summary) so each member sees only their own data.
  // Workspace-level `Workspace.googleOAuthRefreshToken` is separate and intended only for
  // shared org-wide sync (cron / Care Gmail ingest) — an admin sets that explicitly.
  googleOAuthRefreshToken   String?
  googleOAuthEmail          String?
}

// APNs device registrations. One row per (user, device).
// Push delivery: lookup by userId for personal scans, by workspaceId for monitor scans.
model DeviceToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String    @unique // APNs device token (hex)
  platform    String // "ios" — leaves room for "android"/"web" later
  environment String // "sandbox" | "production" — APNs gateway differs
  appBuild    String? // CFBundleVersion at registration — useful for debugging
  appVersion  String? // CFBundleShortVersionString
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now()) // bumped on every successful push send
  failedAt    DateTime? // set if APNs returns BadDeviceToken/Unregistered — soft delete

  @@index([userId, environment])
  @@index([token])
}

model Workspace {
  id                          String                     @id @default(cuid())
  name                        String
  slug                        String                     @unique
  anthropicApiKey             String?
  anthropicModel              String?
  aiProvider                  String                     @default("ANTHROPIC")
  openaiApiKey                String?
  openaiModel                 String?
  geminiApiKey                String?
  geminiModel                 String?
  localLlmUrl                 String?
  localLlmModel               String?
  /// Read-only org Admin API keys used ONLY by the Super-Admin AI Spend card to read
  /// billed cost from the provider Cost APIs. Distinct from the workspace API keys above.
  /// Env vars ANTHROPIC_ADMIN_KEY / OPENAI_ADMIN_KEY take precedence when set.
  anthropicAdminApiKey        String?
  openaiAdminApiKey           String?
  externalApiKey              String?
  googleServiceAccountJson    String?
  googleSubjectEmail          String?
  googleCalendarId            String?
  googleOAuthRefreshToken     String?
  slackBotToken               String? // legacy plaintext — kept for migration; new reads go through slackBotTokenEncrypted
  /// Bot token (xoxb-…) stored as an AES-256-GCM JSON envelope via src/lib/encryption.ts.
  /// `getSlackBotToken(ws)` decrypts this if present, else falls back to the legacy `slackBotToken`.
  slackBotTokenEncrypted      String?
  /// Slack app signing secret (needed to verify inbound interactivity requests).
  /// Encrypted with the same AES-256-GCM envelope. Required for buttons/modals.
  slackSigningSecretEncrypted String?
  /// Slack app identifier (e.g. "A0123456"). Display-only; not a secret.
  slackAppId                  String?
  /// Slack team / workspace identifier returned by auth.test (e.g. "T012ABC").
  slackTeamId                 String?
  /// Slack team / workspace name returned by auth.test. Display-only.
  slackTeamName               String?
  /// Bot user ID returned by auth.test (e.g. "U012BOT"). Lets us ignore the bot's
  /// own events when the Events API is wired up later.
  slackBotUserId              String?
  /// Timestamp of the most recent successful Slack post — diagnostics for the
  /// Settings → Integrations connected-state card.
  lastSlackPostAt             DateTime?
  slackSummaryChannelId       String? // legacy single-channel — kept for migration
  slackChannels               Json? // Array<{ id: string; name: string }>
  channelRoutes               Json? // { "pulse.alert": "C123", "care.escalation": "C456", ... }
  emailProvider               String? // "RESEND" | "SMTP" | null
  emailApiKey                 String? // Resend API key when emailProvider = RESEND
  emailFromAddress            String?
  emailFromName               String?
  emailReplyTo                String?
  emailSmtpHost               String?
  emailSmtpPort               Int?
  emailSmtpUser               String?
  emailSmtpPassword           String?
  branding                    Json? // Cover branding: brandLogoUrl, accents, default confidentiality, etc.
  proposalDefaults            Json? // preparedBy, team, contactDetails, objectiveSnippets
  /// Workspace-wide default rates per CodeClear tier. Shape:
  /// { tier1: { rate, currency, period }, tier2: {...}, tier3: {...} }
  /// Populated by /api/codeclear/admin/tier-defaults; consumed when a
  /// candidate's tier changes (unless RateCardPerson.manualRateOverride).
  tierRateDefaults            Json?
  // ── Public-share branding (P5.19) ───────────────────────────────────
  customHostname              String?                    @unique // Workspace-chosen domain for /docs/[token] (e.g. docs.client.com)
  customHostnameVerified      Boolean                    @default(false)
  customHostnameToken         String? // Random CNAME challenge value for DNS verification
  // ── Backstage (internal ops) ────────────────────────────────────────
  defaultAnnualLeaveDays      Int                        @default(25)
  expenseCategories           Json? // Optional override of the hardcoded category list
  pulsePricingConfig          Json? // PulsePricingConfig — { fxFromUsd, dayRateOverrideGbp?, seniority? } for Pulse engagement pricing
  /// ISO-3166-1 alpha-2 country codes whose public/religious holidays show on the
  /// team calendar for EVERYONE (workspace-wide), independent of where each member
  /// is based. Defaults to UK + Pakistan; admins can extend to other countries.
  holidayCountries            Json                       @default("[\"GB\", \"PK\"]")
  // ── Roles & Permissions ─────────────────────────────────────────────
  /// The role permission matrix — source of truth for what each configurable role
  /// (ADMIN/STAFF/DEVELOPER) can do. Shape: { ADMIN: string[], STAFF: string[], DEVELOPER: string[] }
  /// where each string is a permission id from PERMISSION_CATALOG (src/types/auth.ts).
  /// SUPER_ADMIN is implicit-all and never stored here. Null → DEFAULT_ROLE_PERMISSIONS.
  /// Edited only by Super Admins via /app/settings/roles. A member's resolved
  /// `WorkspaceMember.permissions` is recomputed from this matrix + their overrides.
  rolePermissions             Json?
  // ── MCP / Claude integration (Phase 3) ──────────────────────────────
  /// Workspace-level master switch for the in-app MCP route at /api/mcp.
  /// Off by default — a Super Admin flips this on in Settings → MCP before
  /// any user can connect Claude (or any other MCP client). When off, the
  /// authorize/token endpoints return 503 and no new tokens issue.
  mcpEnabled                  Boolean                    @default(false)
  // ── Docs → Google Drive backup ──────────────────────────────────────
  /// Master switch for the Docs Google Drive backup. Off by default; when on, the daily cron
  /// (and the best-effort on-share hook) mirror documents into Drive as native Google Docs.
  docsBackupEnabled           Boolean                    @default(false)
  /// Cached id of the "Foundry Docs Backup" Drive folder (created by the backup account). All
  /// backed-up Google Docs live under it. Null until the first backup run creates the folder.
  docsBackupFolderId          String?
  /// Cached id of the "Foundry Client Archives" Drive folder — per-client archive subfolders live under it.
  clientArchiveFolderId       String?
  /// Cached id of the "Foundry Cold Storage" Drive folder (retention cold store, drive adapter).
  coldStoreFolderId           String?
  /// Hide developer rates across the platform (On Your Desk cashflow, client cards). Off by default = rates hidden.
  showDevRates                Boolean                    @default(false)
  /// Which revision of the built-in Handbook seed this workspace has received. Bumped in code
  /// (HANDBOOK_SEED_VERSION); when the workspace's stored value is lower, bootstrap re-upserts the
  /// built-in articles by slug once, then advances this. Lets us ship improved built-in content on
  /// deploy without clobbering members' own edits between version bumps. 0 = never seeded.
  handbookSeedVersion         Int                        @default(0)
  golfClubSeedVersion         Int                        @default(0)
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  members                     WorkspaceMember[]
  invites                     WorkspaceInvite[]
  documents                   Document[]
  documentCounters            DocumentCounter[]
  templates                   DocumentTemplate[]
  clients                     WorkspaceClient[]
  clientOnboardings           ClientOnboarding[]
  onboardingForms             OnboardingForm[]
  rateCardPeople              RateCardPerson[]
  proofDocuments              ProofDocument[]
  candidates                  Candidate[]
  pulseScans                  PulseScan[]
  pulseMonitors               PulseMonitor[]
  supportClients              SupportClient[]
  studies                     Study[]
  agentConfigs                AgentConfig[]
  checkConfigs                PulseCheckConfig[]
  signatureRequests           SignatureRequest[]
  slackWebhooks               SlackWebhookSubscription[]
  auditLogs                   AuditLog[]
  meetingSummaries            MeetingSummary[]
  meetings                    Meeting[]
  aiResponseCache             AiResponseCache[]
  leaveRequests               LeaveRequest[]
  expenses                    Expense[]
  clientAssignments           ClientAssignment[]
  tasks                       Task[]
  dailyUpdates                DailyUpdate[]
  featureBlocks               FeatureBlock[]
  milestones                  Milestone[]
  contentSnippets             ContentSnippet[]
  starters                    Starter[]
  mcpConnections              McpConnection[]
  slackMessageRefs            SlackMessageRef[]
  slackUpdateLogs             SlackUpdateLog[]
  broadcasts                  Broadcast[]
  deskReminders               DeskReminder[]
  devSignalAssessments        DevSignalAssessment[]
  devSignalConfigs            DevSignalPipelineConfig[]
  devSignalOutcomeLinks       DevSignalOutcomeLink[]
  devSignalAuditEvents        DevSignalAuditEvent[]
  backgroundJobs              BackgroundJob[]
  coldArchives                ColdArchive[]
  handbookArticles            HandbookArticle[]
  golfClubs                   GolfClub[]
}

/**
 * Reusable content block (Phase 3) — a saved section the operator can drop into any document.
 * Stores the registry section key + the section's data payload, scoped to the workspace.
 */
model ContentSnippet {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  sectionKey  String // Registry section type (prose, costing, …)
  data        Json // The section's data payload at save time
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, sectionKey])
  @@index([workspaceId, createdAt])
}

model WorkspaceMember {
  id                  String    @id @default(cuid())
  workspaceId         String
  userId              String
  role                String    @default("STAFF")
  /// Resolved effective permission ids (a cache). Recomputed from the workspace
  /// role matrix (Workspace.rolePermissions) + this member's permissionOverrides
  /// whenever the matrix, their role, or their overrides change. Every existing
  /// consumer (middleware JWT, requireAuthedUser, hasFeature, canSeeAllClients)
  /// reads this list, so it must always hold the fully-resolved set.
  permissions         Json      @default("[]")
  /// Per-person delta on top of the role matrix. Shape: { grant: string[], revoke: string[] }.
  /// Lets a Super Admin make exceptions (e.g. give one developer code.viewRates)
  /// without changing the whole role. Empty object → pure role inheritance.
  permissionOverrides Json      @default("{}")
  /// Per-dev defaults for the per-client "Push to Slack" composer (Tasks page).
  /// Shape: { detail, statusGroups[], excludedCategoryIds[], defaultNote }. Null →
  /// no saved defaults yet (composer falls back to DEFAULT_PUSH_PREFS). Tasks-page
  /// only — does NOT affect the dashboard AM/PM standup.
  slackPushPrefs      Json?
  // ── Backstage (internal ops) ───────────────────────────────────────
  countryCode         String    @default("GB") // ISO-3166-1 alpha-2; drives date-holidays lookup
  annualLeaveDays     Int? // Per-user override; null falls back to Workspace.defaultAnnualLeaveDays
  createdAt           DateTime  @default(now())
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model WorkspaceInvite {
  id           String    @id @default(cuid())
  workspaceId  String
  token        String    @unique @default(cuid())
  label        String?
  status       String    @default("PENDING") // PENDING | ACCEPTED | REVOKED
  invitedById  String
  acceptedById String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy    User      @relation("InvitesSent", fields: [invitedById], references: [id])
  acceptedBy   User?     @relation("InvitesAccepted", fields: [acceptedById], references: [id])
}

model DocumentTemplate {
  id           String       @id @default(cuid())
  workspaceId  String?
  name         String
  slug         String       @unique
  description  String?
  documentType DocumentType @default(PROPOSAL)
  sections     Json
  metadata     Json?
  isDefault    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  documents    Document[]
}

model Document {
  id                String             @id @default(cuid())
  workspaceId       String
  ownerId           String
  templateId        String?
  documentType      DocumentType       @default(PROPOSAL)
  status            DocumentStatus     @default(DRAFT)
  title             String
  productName       String?
  clientName        String?
  clientId          String?
  client            WorkspaceClient?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  summary           String?
  version           String             @default("v1.0")
  expiresAt         DateTime?
  metadata          Json?
  exportSettings    Json?
  // ── Sharing (Sprint 1) ──────────────────────────────────────────────
  shareToken        String?            @unique // Random URL-safe token for /docs/[token]
  isShared          Boolean            @default(false)
  // ── Engagement tracking (Phase 1) ───────────────────────────────────
  sharedAt          DateTime? // First time sharing was enabled — anchors time-to-first-open
  firstViewedAt     DateTime? // First time the public share link was opened — powers time-to-open + first-open alert
  acceptedAt        DateTime? // When the client accepted via the public page (status → ACCEPTED)
  declinedAt        DateTime? // When the client declined via the public page (status → DECLINED)
  // ── Numbering (Sprint 1) ────────────────────────────────────────────
  documentNumber    String?            @unique // e.g. PROP-2026-014, SLA-2026-003
  // ── Organisation (P0) ───────────────────────────────────────────────
  labels            Json? // Array of workspace-defined label strings (["Q2", "Renewal", …])
  // Workspace-level favourite (the Docs dashboard star + Favorites collection). One flag per
  // doc, visible to the whole team — not per-user. Additive.
  isFavorite        Boolean            @default(false)
  // ── Document relationships (P5) ─────────────────────────────────────
  parentId          String? // Self-ref: SOW under MSA, CO under SOW
  parent            Document?          @relation("DocumentChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children          Document[]         @relation("DocumentChildren")
  // ── Google Drive backup ─────────────────────────────────────────────
  // Backing Google Doc for this document (Docs → Drive backup). `gdriveFileId` is the created
  // Doc's file id — its presence makes the backup idempotent (create when null, update in place
  // otherwise). `gdriveBackedUpAt` stamps the last successful sync; a doc is re-backed-up when
  // `updatedAt > gdriveBackedUpAt`. Both additive/nullable.
  gdriveFileId      String?
  gdriveBackedUpAt  DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  archivedAt        DateTime?
  owner             User               @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template          DocumentTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sections          DocumentSection[]
  costLineItems     CostLineItem[]
  timelinePhases    TimelinePhase[]
  assets            Asset[]
  links             Link[]
  ctas              CTA[]
  exports           Export[]
  proofDocuments    ProofDocument[]
  signatureRequests SignatureRequest[]
  views             DocumentView[]
  comments          DocumentComment[]
  versions          DocumentVersion[]
  presence          EditorPresence[]
  aiSession         DocumentAiSession?

  @@index([workspaceId, status])
  @@index([updatedAt])
  @@index([shareToken])
  @@index([parentId])
  // The Docs list query filters by documentType and orders by updatedAt (no
  // workspace predicate today). This composite serves that exact path so the
  // proposals/contracts list stays fast as documents accumulate.
  @@index([documentType, updatedAt])
}

/**
 * Public commenters or workspace operators leave threaded feedback against a document. Public
 * comments arrive via /docs/[token] (anonymous name + email captured per comment). Workspace
 * comments arrive via the editor and are tied to a User. `sectionId` is optional so a comment
 * can attach to a specific section or to the document overall.
 */
enum DocumentCommentAuthorKind {
  PUBLIC // From the share URL — viewer typed a name + email
  WORKSPACE // From the editor — tied to a User
}

enum DocumentCommentStatus {
  OPEN
  RESOLVED
}

model DocumentComment {
  id           String                    @id @default(cuid())
  documentId   String
  sectionId    String? // null = comment on the document as a whole
  parentId     String? // For replies — points to the root comment
  authorKind   DocumentCommentAuthorKind
  authorName   String // Always required — public: typed in form, workspace: User.name
  authorEmail  String? // Required for PUBLIC, optional for WORKSPACE (we have the User)
  authorUserId String? // Set when authorKind = WORKSPACE
  body         String                    @db.Text
  status       DocumentCommentStatus     @default(OPEN)
  createdAt    DateTime                  @default(now())
  resolvedAt   DateTime?
  resolvedBy   String? // User.id who resolved
  document     Document                  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parent       DocumentComment?          @relation("DocumentCommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies      DocumentComment[]         @relation("DocumentCommentReplies")

  @@index([documentId, status, createdAt])
  @@index([documentId, sectionId])
}

/**
 * Frozen snapshot of a document at a particular version bump. Stores everything needed to
 * render the document in a read-only "viewing v1.2" mode and to diff against any other version.
 * Created when the operator clicks "Save version" or bumps the version field in the editor.
 * Independent of the SignatureRequest.documentSnapshot frozen at send-time (which is signing-
 * scoped, not user-driven).
 */
model DocumentVersion {
  id               String   @id @default(cuid())
  documentId       String
  version          String // e.g. "v1.0", "v1.1", "v2.0" — matches Document.version at snapshot time
  /**
   * Full snapshot of the document's sections array at this version.
   */
  sectionsSnapshot Json
  /**
   * Frozen cost line items (denormalized at snapshot time).
   */
  costSnapshot     Json
  /**
   * Frozen timeline phases.
   */
  timelineSnapshot Json
  /**
   * Free-text changelog the operator typed when bumping the version.
   */
  changelog        String?  @db.Text
  createdById      String
  createdAt        DateTime @default(now())
  document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId, createdAt])
}

/**
 * Lightweight presence heartbeats. The editor pings POST /api/documents/[id]/presence every
 * ~8s with a session token; old rows are pruned. A SELECT for rows seen in the last 30s gives
 * the "who's here" list for the avatar bubbles in the editor header.
 * Not a CRDT or real-time channel — just a polling-friendly "saw you" log.
 */
model EditorPresence {
  id         String   @id @default(cuid())
  documentId String
  userId     String? // Null for unauthenticated/system writes; usually populated for workspace operators
  sessionId  String // Browser-tab-scoped UUID
  userName   String // Snapshot for display so we don't join through User
  lastSeenAt DateTime @default(now()) @updatedAt
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, sessionId])
  @@index([documentId, lastSeenAt])
}

/**
 * AI chat conversation persisted per document. One session per (documentId) — when the user
 * reloads the editor, the chat panel hydrates from this row so the conversation history is not
 * lost. The `messages` JSON is an array of `{ id, role: "user" | "assistant", content, proposals?}`
 * objects that mirror the in-memory shape used by the AiChatPanel component.
 * We don't store full proposal diffs in `messages` — accepted proposals are already applied to
 * the document; rejected proposals fade away on the client. Only the prose turn-by-turn record
 * is preserved so future turns can keep context.
 */
model DocumentAiSession {
  id         String   @id @default(cuid())
  documentId String   @unique
  messages   Json // Array<{ id: string; role: "user" | "assistant"; content: string; createdAt: string }>
  updatedAt  DateTime @default(now()) @updatedAt
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

/**
 * Audit row for each visit to a document's public share URL or signing URL. Powers the view
 * count + last-viewed-at displays in the editor's sidebar, and feeds the activity feed.
 * Recorded by the public pages via fire-and-forget POSTs. `signerId` is set when the visit
 * originated from /sign/[token]; null otherwise (visits to /docs/[token]).
 */
model DocumentView {
  id         String  @id @default(cuid())
  documentId String
  signerId   String?
  ip         String?
  userAgent  String? @db.Text
  referer    String?
  /**
   * Origin of the view — DOCS for /docs/[token], SIGN for /sign/[token].
   */
  origin     String  @default("DOCS")
  // ── Engagement enrichment (Phase 1) ─────────────────────────────────
  // visitorId: first-party cookie, stable across visits → unique-visitor + return-visit counts.
  // sessionId: per page-load UUID → groups this visit's section-dwell events (the beacon can't
  //            read a response, so the client generates it and the events endpoint resolves the
  //            DocumentView by (documentId, sessionId)).
  visitorId  String?
  sessionId  String?
  // Geo + device, resolved server-side. Geo from Vercel's x-vercel-ip-* headers (null off-Vercel);
  // device/browser/os parsed from the UA. All best-effort, all nullable.
  country    String?
  city       String?
  device     String? // mobile | tablet | desktop | bot
  browser    String? // Chrome | Safari | Firefox | Edge | …
  os         String? // iOS | Android | macOS | Windows | …
  durationMs Int? // Total visible time for this visit, flushed on pagehide

  createdAt DateTime            @default(now())
  document  Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signer    SignatureSigner?    @relation(fields: [signerId], references: [id], onDelete: SetNull)
  events    DocumentViewEvent[]

  @@index([documentId, createdAt])
  @@index([documentId, visitorId])
  @@index([documentId, sessionId])
}

/**
 * Per-section engagement for a single visit (Phase 1). One aggregate row per (view, section):
 * how long that section was on-screen (dwellMs) and how deep the viewer scrolled into it
 * (maxScrollPct). The public page accumulates these client-side via an IntersectionObserver and
 * flushes a batch on pagehide; the events endpoint upserts by [viewId, sectionKey], summing dwell.
 * Aggregating dwellMs across views grouped by sectionKey gives the "most/least read sections"
 * heatmap.
 */
model DocumentViewEvent {
  id           String       @id @default(cuid())
  viewId       String
  sectionKey   String // Registry section key (cover, costing, timeline, …)
  sectionTitle String? // Denormalized title for display without joining section data
  dwellMs      Int          @default(0) // Total ms this section was on-screen this visit
  maxScrollPct Int? // Deepest scroll into this section, 0-100
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  view         DocumentView @relation(fields: [viewId], references: [id], onDelete: Cascade)

  @@unique([viewId, sectionKey])
  @@index([viewId])
}

// Per-workspace + per-doc-type + per-year counter for atomic document numbering.
// e.g. workspaceId=W1, documentType=PROPOSAL, year=2026, nextValue=15
//      → next created proposal in 2026 gets PROP-2026-015
model DocumentCounter {
  id           String       @id @default(cuid())
  workspaceId  String
  documentType DocumentType
  year         Int
  nextValue    Int          @default(1)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, documentType, year])
  @@index([workspaceId, documentType])
}

// ── E-signature (Sprint 4) ──────────────────────────────────────────────────────────────────

enum SignatureRequestStatus {
  DRAFT // Request created but not yet sent — workspace can still edit
  SENT // Awaiting signatures
  COMPLETED // All signers signed
  DECLINED // At least one signer declined
  REVOKED // Workspace revoked the request before completion
  EXPIRED // Request passed its expiresAt without completing
}

enum SignatureSignerStatus {
  PENDING // Invited, not yet viewed
  VIEWED // Opened the signing page at least once
  SIGNED
  DECLINED
}

enum SignatureCaptureMethod {
  DRAWN // Canvas / stylus / mouse — stored as PNG data URL
  TYPED // Stylised typed name — stored as the typed string + chosen font
}

enum SignatureEventKind {
  REQUEST_CREATED
  REQUEST_SENT
  REQUEST_REVOKED
  REQUEST_EXPIRED
  REQUEST_COMPLETED
  SIGNER_INVITED
  SIGNER_VIEWED
  SIGNER_SIGNED
  SIGNER_DECLINED
}

/// A single "send for signature" event tied to a document. Carries the signers, status, and an
/// immutable snapshot of the document at send-time (so subsequent edits to the doc don't change
/// what someone is signing).
model SignatureRequest {
  id               String                 @id @default(cuid())
  documentId       String
  workspaceId      String
  createdById      String
  status           SignatureRequestStatus @default(DRAFT)
  message          String?                @db.Text
  expiresAt        DateTime?
  sentAt           DateTime?
  completedAt      DateTime?
  /// JSON snapshot of the document at the moment the request was SENT. Used by the public
  /// /sign/[token] page so subsequent edits don't change what's being signed. Null while the
  /// request is still DRAFT.
  documentSnapshot Json?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  document         Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  workspace        Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy        User                   @relation("SignatureRequestCreator", fields: [createdById], references: [id], onDelete: Cascade)
  signers          SignatureSigner[]
  events           SignatureEvent[]

  @@index([documentId, status])
  @@index([workspaceId, status])
}

/// One signatory on a SignatureRequest. The `accessToken` is what gates /sign/[token] — minted
/// when the request flips from DRAFT to SENT. Once signed, the row carries the captured
/// signature, signer-stated name, IP, and UA for audit.
model SignatureSigner {
  id               String                  @id @default(cuid())
  requestId        String
  /// Order key for sequential signing flows. Null for parallel signing (v1 default).
  signingOrder     Int?
  name             String
  email            String
  role             String
  organization     String?
  /// Mirror of the signature block the parties/signatures section produced. Used to render the
  /// right block in the signed PDF.
  signatureBlockId String?
  accessToken      String                  @unique
  status           SignatureSignerStatus   @default(PENDING)
  signedAt         DateTime?
  declinedAt       DateTime?
  declineReason    String?
  signatureMethod  SignatureCaptureMethod?
  /// Signature payload. For DRAWN: PNG data URL (base64). For TYPED: the typed string.
  signaturePayload String?                 @db.Text
  /// The name the signer typed in the consent box — kept separate from `name` (which is the
  /// invite recipient's name) so we have an auditable record of what they declared.
  signedName       String?
  /// Optional font key for TYPED signatures (e.g. "caveat", "great-vibes").
  signedFontKey    String?
  signedIp         String?
  signedUserAgent  String?                 @db.Text
  invitedAt        DateTime?
  firstViewedAt    DateTime?
  request          SignatureRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  events           SignatureEvent[]
  documentViews    DocumentView[]

  @@index([requestId, signingOrder])
}

/// Append-only audit log for the entire signature lifecycle. Every view / send / sign / revoke
/// creates a row. Used by the Certificate of Completion appendix and any compliance export.
model SignatureEvent {
  id        String             @id @default(cuid())
  requestId String
  signerId  String?
  kind      SignatureEventKind
  ip        String?
  userAgent String?            @db.Text
  metadata  Json?
  createdAt DateTime           @default(now())
  request   SignatureRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  signer    SignatureSigner?   @relation(fields: [signerId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
}

/**
 * Workspace-level Slack webhook subscriptions (P5). One row per (workspace × event class)
 * pairing. When the matching event fires (doc viewed, signed, completed, comment added), the
 * server POSTs a formatted Slack Block Kit message to `webhookUrl`.
 * Distinct from Workspace.slackBotToken (which authenticates a full Slack bot for the meeting-
 * summary feature) — webhooks are simpler and per-event-class.
 */
enum DocumentEventKind {
  DOC_SHARED // Workspace minted a share link
  DOC_VIEWED // Public visitor opened the share URL
  DOC_SENT // Sent for signature
  DOC_SIGNED // A signer signed
  DOC_COMPLETED // All signers signed
  DOC_DECLINED // A signer declined
  COMMENT_ADDED // Public or workspace comment added
}

model SlackWebhookSubscription {
  id          String    @id @default(cuid())
  workspaceId String
  label       String // Operator-facing label ("#proposals notifications")
  webhookUrl  String    @db.Text
  eventKinds  Json // Array<DocumentEventKind>
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, enabled])
}

model ProofDocument {
  id           String    @id @default(cuid())
  workspaceId  String
  ownerId      String
  proposalId   String?
  title        String
  markdown     String?
  slug         String    @unique
  shareUrl     String
  tokenUrl     String
  accessToken  String
  source       String    @default("proof")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastOpenedAt DateTime  @default(now())
  archivedAt   DateTime?
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  proposal     Document? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@index([workspaceId, lastOpenedAt])
  @@index([proposalId, lastOpenedAt])
}

/// Lifecycle status for a client row in Portal. Existing rows backfill to ACTIVE
/// on migration. PENDING_REVIEW is set when a client submits the onboarding flow
/// and is waiting for Dan/Harry to approve and move to active workflow.
enum WorkspaceClientStatus {
  PENDING_REVIEW
  ACTIVE
  ARCHIVED
  /// A prospect / lead — interested but not yet an active client. Lives in the Portal
  /// "Leads" tab; converting to ACTIVE is a status flip. (Additive — see PR #189 note.)
  LEAD
  /// A paused client (e.g. between project phases) — kept out of Active but easy to
  /// "pick back up". Optional resumeAt + pauseNote on the row. (Additive.)
  INACTIVE
}

/// Sales pipeline stage for a lead (status = LEAD). Surfaced on the lead card + detail.
enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

model WorkspaceClient {
  id                       String                    @id @default(cuid())
  workspaceId              String
  name                     String
  slug                     String
  logoUrl                  String?
  /// Gitwork product/account leads shown on the client wiki header (User ids,
  /// display order preserved). Distinct from the delivery team (devs via placements).
  productTeamUserIds       String[]                  @default([])
  website                  String?
  addressLine1             String?
  addressLine2             String?
  city                     String?
  /// UK address line — county / region (the Typeform's "State/Region/Province").
  county                   String?
  postcode                 String?
  country                  String?
  notes                    String?                   @db.Text
  primaryContactName       String?
  primaryContactEmail      String?
  primaryContactPhone      String?
  /// Where invoices are sent — "which email should we send invoices to?".
  /// Distinct from primaryContactEmail (the day-to-day contact).
  invoiceEmail             String?
  googleDriveFolderUrl     String?
  clickupUrl               String?                   @db.Text
  /// Legacy single Slack channel id (pre-Phase-3). New code reads
  /// `effectiveInternalChannel(client) = slackInternalChannelId ?? slackChannelId`
  /// — kept until Phase 4 drops it so deploys roll forward / back without losing the link.
  slackChannelId           String?
  /// Internal channel (Gitwork-only, typically private) for the client's project
  /// updates. Set by `provisionClientChannels` on create OR manually picked in the
  /// Edit-client modal. Replaces `slackChannelId` going forward.
  slackInternalChannelId   String?
  slackInternalChannelName String?
  /// External / Slack Connect channel shared with the client's Slack workspace.
  /// Provisioned via conversations.inviteShared — requires the bot's
  /// `conversations.connect:write/manage` scopes (granted at install).
  slackExternalChannelId   String?
  slackExternalChannelName String?
  /// Sticky error string from the last channel-provisioning attempt. Cleared on
  /// success. Drives the "Provision Slack channels" retry button on Edit Client.
  slackProvisionError      String?
  hidden                   Boolean                   @default(false)
  /// Lifecycle status. New onboarding submissions arrive as PENDING_REVIEW;
  /// Dan/Harry flip to ACTIVE via Move-to-workflow. Pulse scans are gated to
  /// ACTIVE clients only.
  status                   WorkspaceClientStatus     @default(ACTIVE)
  /// Registered company name when it differs from the trading name above.
  legalCompanyName         String?
  /// Company registration number (Companies House etc.).
  companyNumber            String?
  /// VAT registration number.
  vatNumber                String?
  /// Billing address — populated only when it differs from the HQ address above.
  billingAddressLine1      String?
  billingAddressLine2      String?
  billingCity              String?
  billingCounty            String?
  billingPostcode          String?
  billingCountry           String?
  /// Public Gantt/timeline share. Token minted on first enable; toggling off
  /// keeps the token so the same URL re-activates. Public page checks both.
  /// NOT a DB unique constraint: adding a unique index trips `prisma db push`'s
  /// data-loss guard, which the Vercel build never force-applies (it would skip
  /// the whole migration). The token is 144 bits of randomness and lookups use
  /// findFirst, so a plain index is enough.
  timelineShareToken       String?
  timelineShareEnabled     Boolean                   @default(false)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  workspace                Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pulseScans               PulseScan[]
  platforms                ClientPlatform[]
  designs                  ClientDesign[]
  documents                Document[]
  supportClients           SupportClient[]
  placements               Placement[]
  studies                  Study[]
  meetings                 Meeting[]
  devSignalAssessments     DevSignalAssessment[]
  devSignalConfigs         DevSignalPipelineConfig[]
  bankAccount              ClientBankAccount?
  onboarding               ClientOnboarding?
  designSystem             ClientDesignSystem?
  wiki                     ClientWiki?
  assignments              ClientAssignment[]
  tasks                    Task[]
  featureBlocks            FeatureBlock[]
  milestones               Milestone[]
  /// Monthly retainer-day allocation. Optional — surfaced in the UI only when set.
  retainerDays             Int?
  /// Retainer days used in the current month (manually maintained). Paired with
  /// retainerDays as a "used / allowance" readout.
  retainerDaysUsed         Int?
  /// The month (YYYY-MM, UTC) that `retainerDaysUsed` belongs to. When this is an
  /// earlier month than today, the used figure is treated as 0 on read (lazy monthly
  /// reset) and re-stamped to the current month on the next edit.
  retainerPeriodMonth      String?
  /// Cached id of this client's archive subfolder under "Foundry Client Archives".
  archiveDriveFolderId     String?
  /// When the client's dataset was last exported to Drive (archive/delete lifecycle).
  /// The reconcile cron re-exports when `updatedAt > archivedToDriveAt`.
  archivedToDriveAt        DateTime?
  // ── Leads (status = LEAD) — all additive, nullable ──
  leadSource               String?
  leadStage                LeadStage?
  leadFollowUpAt           DateTime?
  leadValue                Int?
  leadValueCurrency        String?                   @default("GBP")
  // ── Paused / inactive (status = INACTIVE) ──
  resumeAt                 DateTime?
  pauseNote                String?
  touchpoints              ClientTouchpoint[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, name])
  @@index([workspaceId, status])
  @@index([timelineShareToken])
  @@map("Client")
}

/// A logged lead/client touchpoint (call, email, meeting, note) — the CRM activity log
/// surfaced on a lead's detail. Additive; cascades with its client.
model ClientTouchpoint {
  id          String          @id @default(cuid())
  clientId    String
  client      WorkspaceClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workspaceId String
  /// CALL | EMAIL | MEETING | NOTE
  type        String
  note        String?
  occurredAt  DateTime        @default(now())
  /// workspace User id of the author; null = system/unknown.
  authorId    String?
  createdAt   DateTime        @default(now())

  @@index([clientId, occurredAt])
}

model ClientPlatform {
  id              String                @id @default(cuid())
  clientId        String
  client          WorkspaceClient       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name            String
  platformType    String?
  url             String?
  stagingUrl      String?
  repoUrl         String?
  /// When true, this platform's production + staging URLs surface as buttons in
  /// the client wiki header. Only the first featured platform is used.
  featuredInWiki  Boolean               @default(false)
  credentials     String?               @db.Text // LEGACY plaintext — migrated into passwordCipher then nulled (see /api/dev/encrypt-platform-credentials)
  usernameCipher  String?               @db.Text // AES-256-GCM envelope (src/lib/encryption.ts)
  passwordCipher  String?               @db.Text // AES-256-GCM envelope
  notes           String?               @db.Text
  previewImageUrl String?               @db.Text
  /// Placements engaged on this platform — drives the scoped GitHub scan.
  placements      Placement[]
  /// Multiple credential sets ("logins") — supersedes the single username/password ciphers
  /// above, which are migrated into one login each (see /api/dev/migrate-platform-logins).
  logins          ClientPlatformLogin[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([clientId])
  @@map("ClientPlatform")
}

/// One credential set on a platform (e.g. "Admin", "FTP"). username/password encrypted at rest
/// with AES-256-GCM (src/lib/encryption.ts); the plaintext is only returned by the reveal route.
model ClientPlatformLogin {
  id             String         @id @default(cuid())
  platformId     String
  platform       ClientPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  label          String?
  usernameCipher String?        @db.Text
  passwordCipher String?        @db.Text
  orderKey       Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([platformId])
}

model ClientDesign {
  id              String          @id @default(cuid())
  clientId        String
  client          WorkspaceClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name            String
  url             String?         @db.Text
  notes           String?         @db.Text
  previewImageUrl String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([clientId])
  @@map("ClientDesign")
}

enum DesignSystemStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// Per-client brand design system. Stores the DesignTokens JSON (see
/// src/types/design-tokens.ts) produced by the Cowork `design-system` skill; the
/// Portal viewer + public /brand/[token] page render from it. Additive (1:1, like
/// ClientBankAccount). `shareToken` is intentionally NOT @unique — see the note on
/// WorkspaceClient.timelineShareToken (a unique index trips the build's data-loss guard).
model ClientDesignSystem {
  id                  String             @id @default(cuid())
  clientId            String             @unique
  client              WorkspaceClient    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Nullable so a client's page can be enabled before any tokens are imported.
  tokens              Json?
  status              DesignSystemStatus @default(DRAFT)
  /// Per-client page toggle (set in Edit client). Tri-state: null = unset, so the
  /// page defaults to visible when tokens exist; true/false is an explicit override.
  enabled             Boolean?
  /// Show the Foundry masthead/footer branding on the guidelines. Off = clean own-brand doc.
  showFoundryBranding Boolean            @default(true)
  /// Opt-in: expose the client-branded Brand Guidelines deck (+ tab + PDF). Off by default.
  guidelinesEnabled   Boolean            @default(false)
  shareToken          String?
  shareEnabled        Boolean            @default(false)
  updatedById         String?
  updatedBy           User?              @relation("DesignSystemUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([shareToken])
  @@map("ClientDesignSystem")
}

// ─── Client Knowledge Wiki ────────────────────────────────────────────────────

/// Per-client knowledge hub: app-store listings, changelog, IA guide, dev API
/// guide. The design-system page is a separate route but linked from the wiki
/// sidebar. `shareToken` follows the same pattern as ClientDesignSystem.timelineShareToken —
/// NOT @unique to avoid the Prisma db push data-loss guard; lookups use findFirst.
model ClientWiki {
  id                  String                 @id @default(cuid())
  clientId            String                 @unique
  client              WorkspaceClient        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  shareToken          String?
  shareEnabled        Boolean                @default(false)
  /// Secret token for the inbound course-request API. When set, external systems
  /// can POST course requests to /api/public/course-requests/[token]. Null = off.
  courseIngestToken   String?                @unique
  /// Enabled changelog platforms for this wiki (e.g. ["IOS","ANDROID","WEB"]).
  /// Null falls back to the default IOS/ANDROID/WEB set; FIRESTICK is opt-in.
  platforms           Json?
  /// Per-page public share tokens: { "<section>": "<token>" } for individually
  /// shared sections (ia / dev-guide / api-docs / changelog etc.). shareToken above is whole-wiki.
  pageShares          Json?
  /// Section slugs manually removed from the private sidebar. Add New removes
  /// entries from this list when a page is restored.
  hiddenSections      Json?
  /// Flat list of the per-page tokens above, for fast public lookup by token.
  pageShareTokens     String[]               @default([])
  /// DEPRECATED (v1 single-credential gate, superseded by ClientWikiUser).
  /// Kept to avoid Prisma's data-loss guard on a column drop; no longer read.
  accessProtected     Boolean                @default(false)
  accessUsername      String?
  accessPasswordHash  String?
  /// Whether the Monitors (uptime) section is enabled for this wiki. The section
  /// appears once enabled; individual monitors live in WikiMonitor.
  monitorsEnabled     Boolean                @default(false)
  /// Whether the Documents section is enabled. Entries live in WikiDocument.
  documentsEnabled    Boolean                @default(false)
  /// Whether the Requests (client intake) section is enabled. When off, the
  /// section is hidden and the public token-based intake API rejects pushes.
  /// Defaults false so a fresh wiki starts minimal (Dashboard + Timeline only);
  /// existing wikis keep whatever value they already have stored.
  intakeEnabled       Boolean                @default(false)
  /// Whether the Code Handover section is enabled — versioned source per hardware
  /// module (e.g. Receiver / Sender firmware) handed to the client to flash.
  codeHandoverEnabled Boolean                @default(false)
  pages               ClientWikiPage[]
  changelog           ClientChangelogEntry[]
  courseRequests      ClientCourseRequest[]
  intakeItems         ClientWikiIntakeItem[]
  wikiUsers           ClientWikiUser[]
  monitors            WikiMonitor[]
  documents           WikiDocument[]
  codeModules         WikiCodeModule[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([shareToken])
  @@map("ClientWiki")
}

/// A hardware/firmware "module" handed over to a client (e.g. "Receiver",
/// "Sender") — a named bucket of versioned source. Lives in the wiki Code
/// Handover section; the client copies/downloads it to flash themselves.
model WikiCodeModule {
  id          String            @id @default(cuid())
  wikiId      String
  wiki        ClientWiki        @relation(fields: [wikiId], references: [id], onDelete: Cascade)
  name        String
  description String?           @db.Text
  orderKey    Int               @default(0)
  versions    WikiCodeVersion[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([wikiId])
  @@map("WikiCodeModule")
}

/// One version of a module's code (e.g. "v1.2.0"). The current version is shown
/// prominently; older versions collapse into an accordion. Files live inline.
model WikiCodeVersion {
  id        String         @id @default(cuid())
  moduleId  String
  module    WikiCodeModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  label     String
  notes     String?        @db.Text
  isCurrent Boolean        @default(false)
  files     WikiCodeFile[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([moduleId])
  @@map("WikiCodeVersion")
}

/// A single source file within a code version (filename + optional language hint
/// for highlighting + the pasted contents).
model WikiCodeFile {
  id        String          @id @default(cuid())
  versionId String
  version   WikiCodeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  filename  String
  language  String?
  content   String          @db.Text
  orderKey  Int             @default(0)

  @@index([versionId])
  @@map("WikiCodeFile")
}

/// A document surfaced in a wiki's Documents section — a Foundry doc, an external
/// link (Google Docs, etc.), or an uploaded file (stored inline as bytea). Shown
/// as a clean titled card; raw URLs are never exposed to clients.
model WikiDocument {
  id        String           @id @default(cuid())
  wikiId    String
  wiki      ClientWiki       @relation(fields: [wikiId], references: [id], onDelete: Cascade)
  title     String
  kind      WikiDocumentKind @default(LINK)
  /// External URL (LINK) or the Foundry doc share URL (FOUNDRY). Null for FILE.
  url       String?
  /// Uploaded file bytes (FILE only). Kept inline — volume is low; migrate to
  /// object storage if it grows (same trade-off as Backstage receipts).
  fileData  Bytes?
  fileName  String?
  fileMime  String?
  fileSize  Int?
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([wikiId])
  @@map("WikiDocument")
}

enum WikiDocumentKind {
  FOUNDRY
  LINK
  FILE
}

/// A single uptime/health monitor within a wiki's Monitors section. Probed on a
/// schedule by /api/cron/wiki-monitors; each probe writes a WikiMonitorCheck and
/// updates the denormalised `last*` fields for fast reads.
model WikiMonitor {
  id              String             @id @default(cuid())
  wikiId          String
  wiki            ClientWiki         @relation(fields: [wikiId], references: [id], onDelete: Cascade)
  name            String
  /// Connector type — see src/server/wiki-monitors (HTTP, TCP, …).
  type            WikiMonitorType    @default(HTTP)
  /// URL for HTTP; "host:port" for TCP.
  target          String
  /// HTTP request method (HTTP only).
  method          String             @default("GET")
  /// Exact expected HTTP status; null = any 2xx/3xx counts as up.
  expectedStatus  Int?
  /// Optional body substring that must be present for the check to pass (HTTP).
  keyword         String?
  /// Latency (ms) above which an otherwise-up check is reported DEGRADED. Null = off.
  degradedMs      Int?
  enabled         Boolean            @default(true)
  intervalMinutes Int                @default(5)
  sortOrder       Int                @default(0)
  /// Denormalised latest result for fast public reads.
  lastStatus      WikiMonitorStatus  @default(UNKNOWN)
  lastCheckedAt   DateTime?
  lastLatencyMs   Int?
  lastStatusCode  Int?
  lastError       String?
  checks          WikiMonitorCheck[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([wikiId])
  @@map("WikiMonitor")
}

/// One probe result for a WikiMonitor — the history behind uptime % and the
/// recent-status bar strip. Pruned by the cron beyond the retention window.
model WikiMonitorCheck {
  id         String            @id @default(cuid())
  monitorId  String
  monitor    WikiMonitor       @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  status     WikiMonitorStatus
  latencyMs  Int?
  statusCode Int?
  error      String?
  checkedAt  DateTime          @default(now())

  @@index([monitorId, checkedAt])
  @@map("WikiMonitorCheck")
}

enum WikiMonitorType {
  HTTP
  TCP
}

enum WikiMonitorStatus {
  UP
  DEGRADED
  DOWN
  UNKNOWN
}

/// A client-facing login for the PUBLIC wiki link. Multiple per wiki; the team
/// manages them in the wiki's Settings. Clients sign in with email + password
/// (bcrypt-hashed); Gitwork staff bypass via their Foundry session. Replaces the
/// deprecated single-credential fields on ClientWiki.
model ClientWikiUser {
  id           String     @id @default(cuid())
  wikiId       String
  wiki         ClientWiki @relation(fields: [wikiId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  name         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([wikiId, email])
  @@index([wikiId])
  @@map("ClientWikiUser")
}

/// A single page/section within a ClientWiki. One row per type per wiki
/// (enforced by the unique constraint). Content is a JSON blob whose shape
/// varies by type: markdown string for guide/docs pages, structured
/// key-value record for APP_STORE_* pages.
model ClientWikiPage {
  id        String       @id @default(cuid())
  wikiId    String
  wiki      ClientWiki   @relation(fields: [wikiId], references: [id], onDelete: Cascade)
  type      WikiPageType
  title     String
  content   Json?
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([wikiId, type])
  @@index([wikiId])
  @@map("ClientWikiPage")
}

/// Client-submitted bugs, feedback, and lightweight task requests kept inside
/// the Wiki until a Gitwork admin/super-admin promotes one into Portal Tasks.
model ClientWikiIntakeItem {
  id          String               @id @default(cuid())
  wikiId      String
  wiki        ClientWiki           @relation(fields: [wikiId], references: [id], onDelete: Cascade)
  type        WikiIntakeItemType   @default(FEEDBACK)
  title       String
  description String?              @db.Text
  priority    TaskPriority         @default(MEDIUM)
  status      WikiIntakeItemStatus @default(NEW)
  requestedBy String?
  externalRef String?
  source      String?
  taskId      String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([wikiId])
  @@index([wikiId, externalRef])
  @@map("ClientWikiIntakeItem")
}

enum WikiIntakeItemType {
  BUG
  FEEDBACK
  TASK
}

enum WikiIntakeItemStatus {
  NEW
  TRIAGED
  PROMOTED
  CLOSED
}

/// A single version-release entry in the client's changelog. Linked to a wiki.
model ClientChangelogEntry {
  id         String          @id @default(cuid())
  wikiId     String
  wiki       ClientWiki      @relation(fields: [wikiId], references: [id], onDelete: Cascade)
  platform   WikiPlatform
  version    String
  title      String
  body       String?         @db.Text
  releasedAt DateTime?
  /// Review state — PENDING until the release notes are approved for publishing.
  status     WikiEntryStatus @default(PENDING)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([wikiId])
  @@map("ClientChangelogEntry")
}

/// A golf-course request/change for a client (Wedge), triaged from support feedback
/// or added manually, tracked toward the client's course-data API provider.
model ClientCourseRequest {
  id                   String              @id @default(cuid())
  wikiId               String
  wiki                 ClientWiki          @relation(fields: [wikiId], references: [id], onDelete: Cascade)
  courseName           String
  country              String?
  status               CourseRequestStatus @default(NEW)
  notes                String?             @db.Text
  /// Internal: the Care conversation this was imported from (dedupe; not surfaced).
  sourceConversationId String?
  /// Where this request came from: "feedback" | "api" | "manual".
  source               String?
  /// Caller-supplied external id for the inbound API (idempotent dedupe).
  externalRef          String?
  /// Timestamp when status was last set to SENT (auto-set by updateCourseRequest).
  sentAt               DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([wikiId])
  @@index([wikiId, externalRef])
  @@map("ClientCourseRequest")
}

enum CourseRequestStatus {
  NEW
  SENT
  ADDED
  REJECTED
}

/// Canonical golf equipment (clubs) dataset — the "Equipment" domain of the
/// Gitwork Golf Data platform, consumed by Wedge + partner devs via the
/// /api/golf/clubs export endpoints. Schema mirrors the gitwork-golf-data repo's
/// EquipmentModelRecord (manufacturer / category / model / family / year / specs
/// + variants). One row per model; variants (lofts/flex/handedness) live inline.
model GolfClub {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  manufacturer String
  /// Driver · Fairway Wood · Hybrid · Iron Set · Wedge · Putter · …
  category     String
  modelName    String
  modelFamily  String?
  modelYear    Int?
  /// active | discontinued
  status       String    @default("active")
  /// manufacturer:category:year:model slug — the dedupe key.
  naturalKey   String
  aliases      String[]
  imageUrls    String[]
  /// Flat specification map (e.g. { headMaterial, adjustableLoft, setComposition }).
  specs        Json?
  /// Array of { name, loft?, flex?, handedness?, sku? }.
  variants     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([workspaceId, naturalKey])
  @@index([workspaceId, category])
  @@index([workspaceId, manufacturer])
  @@map("GolfClub")
}

enum WikiPageType {
  IA_GUIDE
  DEV_API_GUIDE
  API_DOCS
  ARCHITECTURE
  RUNBOOK
  DATA_MODEL
  APP_STORE_IOS
  APP_STORE_ANDROID
  APP_STORE_FIRESTICK
  SYSTEM_STATUS
  CUSTOM
}

enum WikiPlatform {
  IOS
  ANDROID
  FIRESTICK
  WEB
  ALL
}

enum WikiEntryStatus {
  PENDING
  APPROVED
}

/// Self-serve client onboarding session. Created when the team mints an
/// onboarding link in Portal; the row stores autosaved answers as the client
/// completes the public /onboarding/[token] flow. Independent of WorkspaceClient
/// — a Pending client is only materialised when the session is moved to
/// workflow, so half-finished link clicks never pollute Portal.
model ClientOnboarding {
  id                  String                       @id @default(cuid())
  workspaceId         String
  workspace           Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Token used in the public URL (`/onboarding/[accessToken]`). Rotated on revoke.
  accessToken         String                       @unique
  /// "IN_PROGRESS" | "SUBMITTED" | "LINKED". Plain string so we can extend without a migration.
  status              String                       @default("IN_PROGRESS")
  /// Last step index the client reached. Drives "resume where you left off".
  currentStep         Int                          @default(0)
  /// Operator-facing label shown in the Onboarding links tab ("Acme call from Tuesday").
  label               String?
  // ── Form (template) provenance + snapshot ───────────────────────────
  /// Which OnboardingForm this link was minted from (provenance only; rendering uses the snapshot).
  formId              String?
  form                OnboardingForm?              @relation(fields: [formId], references: [id], onDelete: SetNull)
  /// Frozen OnboardingFormStructure rendered by the public flow. Null on legacy rows → the
  /// public flow falls back to the in-code default form, so old links keep working unchanged.
  formSnapshot        Json?
  /// Custom-field answers keyed by field id. System fields stay in their dedicated columns below.
  answers             Json?
  // ── Autosaved answers (system fields → mapped into WorkspaceClient on submit) ──
  // Contact — split first/last to mirror the live Gitwork invoicing Typeform.
  contactFirstName    String?
  contactLastName     String?
  contactEmail        String?
  contactRole         String?
  contactPhone        String?
  // Invoice recipient — "which email should we send invoices to?" (separate from contact email).
  invoiceEmail        String?
  companyName         String?
  legalCompanyName    String?
  companyNumber       String?
  vatNumber           String?
  // HQ / registered address — UK-default labels (Town/City, County, Postcode).
  addressLine1        String?
  addressLine2        String?
  city                String?
  county              String?
  postcode            String?
  country             String?
  // Billing address — only meaningful when billingDiffers = true.
  billingDiffers      Boolean                      @default(false)
  billingAddressLine1 String?
  billingAddressLine2 String?
  billingCity         String?
  billingCounty       String?
  billingPostcode     String?
  billingCountry      String?
  productName         String?
  productUrl          String?
  productDescription  String?                      @db.Text
  projectGoals        String?                      @db.Text
  bankAccount         ClientOnboardingBankAccount?
  /// Set when Move-to-workflow materialises a WorkspaceClient from this session.
  workspaceClientId   String?                      @unique
  workspaceClient     WorkspaceClient?             @relation(fields: [workspaceClientId], references: [id], onDelete: SetNull)
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  /// First time the public onboarding link was opened — powers the "opened?" signal in Portal.
  firstViewedAt       DateTime?
  submittedAt         DateTime?
  linkedAt            DateTime?

  @@index([workspaceId, status, updatedAt])
  @@index([accessToken])
}

/// Encrypted bank details collected during onboarding. Mirrored to
/// ClientBankAccount when the session is moved to workflow. Every *Cipher column
/// stores a JSON envelope produced by `encrypt()` in src/lib/encryption.ts:
/// `{ v: 1, iv, ct, tag }` (AES-256-GCM, base64).
model ClientOnboardingBankAccount {
  id                  String           @id @default(cuid())
  onboardingId        String           @unique
  onboarding          ClientOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  accountHolderCipher String?          @db.Text
  bankNameCipher      String?          @db.Text
  sortCodeCipher      String?          @db.Text
  accountNumberCipher String?          @db.Text
  ibanCipher          String?          @db.Text
  swiftBicCipher      String?          @db.Text
  /// ISO 4217 currency code, e.g. GBP / USD / EUR. Plaintext for filtering.
  currency            String?          @db.VarChar(3)
  /// Last 4 digits of the account number — plaintext convenience for the Portal UI
  /// so the operator sees "•••• 4321" without having to decrypt.
  accountNumberLast4  String?          @db.VarChar(4)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

/// A customisable onboarding form (template). Mirrors DocumentTemplate: the whole
/// step/field structure + copy lives in `steps` (Json). When a link is minted the
/// structure is snapshotted onto ClientOnboarding.formSnapshot, so editing a form
/// never changes links already sent out.
model OnboardingForm {
  id          String             @id @default(cuid())
  workspaceId String?
  workspace   Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  name        String
  slug        String             @unique
  description String?
  /// OnboardingFormStructure: { welcome, steps[], review }. Validated in app code, not Prisma.
  steps       Json
  /// Reserved for theme accents / estimated-time / future per-form settings.
  settings    Json?
  isDefault   Boolean            @default(false)
  isArchived  Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  onboardings ClientOnboarding[]

  @@index([workspaceId, isArchived, updatedAt])
}

/// Encrypted bank details for an active client. Same schema as the onboarding
/// table — moved over (and the onboarding row removed) by moveToWorkflow.
model ClientBankAccount {
  id                  String          @id @default(cuid())
  clientId            String          @unique
  client              WorkspaceClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  accountHolderCipher String?         @db.Text
  bankNameCipher      String?         @db.Text
  sortCodeCipher      String?         @db.Text
  accountNumberCipher String?         @db.Text
  ibanCipher          String?         @db.Text
  swiftBicCipher      String?         @db.Text
  currency            String?         @db.VarChar(3)
  accountNumberLast4  String?         @db.VarChar(4)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model Candidate {
  id                   String                 @id @default(cuid())
  workspaceId          String
  rateCardPersonId     String?
  name                 String
  githubHandle         String
  email                String?
  primaryStack         String
  techStacks           String[]               @default([])
  signalSources        String[]               @default([])
  location             String?
  bio                  String?
  /// Short tagline (≤25 chars) shown under the dev's name on the client wiki
  /// team-avatar hover. Distinct from `bio` (the longer GitHub/CodeClear bio).
  wikiBio              String?
  status               PipelineStatus         @default(SOURCED)
  /// Derived tier (see codeclear-scoring.ts deriveTier). Persisted as a
  /// snapshot for cheap reads / SQL filters; rebuilt whenever the score
  /// changes. Effective tier in the UI = tierManualOverride ?? tier.
  tier                 CodeClearTier          @default(TIER_3)
  /// Admin escape hatch — when set, the UI shows this tier instead of the
  /// derived one. We never overwrite the derived value, so we can show
  /// "Override (was Tier 2)" in the drawer.
  tierManualOverride   CodeClearTier?
  /// INTERNAL = a Gitwork team member. EXTERNAL = sourced for the marketplace.
  /// Existing rows default to INTERNAL so nothing changes for current devs.
  origin               CandidateOrigin        @default(INTERNAL)
  /// Organisational grouping — see CandidateDevGroup. Defaults to BENCH so
  /// every existing dev lands on the commercial roster. PRO_BONO devs are
  /// shown in a separate section on the Developers list and excluded from
  /// cost rollups. Additive — nothing breaks if downstream code ignores it.
  devGroup             CandidateDevGroup      @default(BENCH)
  /// Reserved flag for the future marketplace — flips a dev from "in
  /// validation" to "available to clients". Does nothing yet client-side.
  published            Boolean                @default(false)
  avatarUrl            String?
  linkedinUrl          String?
  cvUrl                String?
  portfolioUrl         String?
  yearsExperience      Int?
  hourlyRate           Decimal?               @db.Decimal(10, 2)
  currency             String?                @db.VarChar(3)
  timezone             String?
  /// User-overridable availability. When null, derive from open Placement
  /// (open placement → ENGAGED, otherwise AVAILABLE).
  availability         CandidateAvailability?
  recheckDueAt         DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  workspace            Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rateCardPerson       RateCardPerson?        @relation(fields: [rateCardPersonId], references: [id], onDelete: SetNull)
  score                CodeClearScore?
  scoreDraft           CodeClearScoreDraft?
  githubAnalysisRuns   GitHubAnalysisRun[]
  checks               CodeClearCheck[]
  placements           Placement[]
  notes                Note[]
  activityLog          ActivityLog[]
  devSignalAssessments DevSignalAssessment[]

  @@unique([workspaceId, githubHandle])
  @@index([workspaceId, status])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, recheckDueAt])
  @@index([workspaceId, origin, published])
}

/// One row per validation finding. Mirrors PulseScanCheck. The most recent run
/// is the source of truth; older check rows hang around for audit.
model CodeClearCheck {
  id          String               @id @default(cuid())
  candidateId String
  candidate   Candidate            @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  runId       String?
  run         GitHubAnalysisRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)
  /// When set, this check came from a scoped (per-placement) scan and
  /// should only show in that placement's validation pane.
  placementId String?
  placement   Placement?           @relation("PlacementChecks", fields: [placementId], references: [id], onDelete: SetNull)
  category    String
  checkKey    String
  label       String
  status      CodeClearCheckStatus
  detail      String?
  evidence    String?
  weight      Int                  @default(1)
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())

  @@index([candidateId, category])
  @@index([candidateId, sortOrder])
  @@index([placementId, sortOrder])
  @@index([runId])
}

/// Curated list of tech stacks. Replaces the hard-coded TECH_STACK_OPTIONS so
/// admins can add stacks without a deploy. Seeded on first migration.
model TechStack {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String?
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model CodeClearScore {
  id                 String             @id @default(cuid())
  candidateId        String             @unique
  candidate          Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  technicalDepth     Int                @default(0)
  codeQuality        Int                @default(0)
  aiFluency          Int                @default(0)
  deliveryReadiness  Int                @default(0)
  identityConfidence IdentityConfidence @default(PENDING)
  overallScore       Int                @default(0)
  taskScore          Int?
  taskTimeSeconds    Int?
  taskAiReview       String?
  verifiedAt         DateTime?
  validUntil         DateTime?
  reminderSentAt     DateTime?
  expiredAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model CodeClearScoreDraft {
  id                 String              @id @default(cuid())
  candidateId        String              @unique
  candidate          Candidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  technicalDepth     Int?
  codeQuality        Int?
  aiFluency          Int?
  deliveryReadiness  Int?
  identityConfidence IdentityConfidence?
  overallScore       Int?
  taskScore          Int?
  taskTimeSeconds    Int?
  taskAiReview       String?
  sourceRunId        String?
  sourceRun          GitHubAnalysisRun?  @relation("GitHubAnalysisRunDraftSource", fields: [sourceRunId], references: [id], onDelete: SetNull)
  lastAppliedAt      DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model GitHubAnalysisRun {
  id                           String                      @id @default(cuid())
  candidateId                  String
  candidate                    Candidate                   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  drafts                       CodeClearScoreDraft[]       @relation("GitHubAnalysisRunDraftSource")
  checks                       CodeClearCheck[]
  /// PROFILE = scan the dev's whole GitHub profile (legacy default).
  /// REPO    = scan a specific repo for this dev's contributions.
  scope                        GitHubAnalysisScope         @default(PROFILE)
  /// When `scope = REPO`, the placement this scan was scoped to. The
  /// dev "validated" the engagement, not just their profile.
  placementId                  String?
  placement                    Placement?                  @relation("PlacementScans", fields: [placementId], references: [id], onDelete: SetNull)
  placementLastScans           Placement[]                 @relation("PlacementLastScan")
  /// Snapshot of the repo URL that was scanned. Stored explicitly so
  /// audit history survives even if the ClientPlatform.repoUrl is later
  /// changed.
  scopedRepoUrl                String?
  /// Snapshot of the paths filter at scan time. Same audit reason.
  scopedRepoPaths              String[]                    @default([])
  scopedRepoBranch             String?
  status                       GitHubAnalysisStatus        @default(RUNNING)
  triggerSource                GitHubAnalysisTriggerSource @default(MANUAL)
  analysisVersion              String
  startedAt                    DateTime                    @default(now())
  completedAt                  DateTime?
  profileSnapshot              Json?
  repoSnapshot                 Json?
  metrics                      Json?
  redFlags                     Json?
  recommendedTechnicalDepth    Int?
  recommendedCodeQuality       Int?
  recommendedDeliveryReadiness Int?
  llmSummary                   String?
  errorCode                    String?
  errorMessage                 String?
  createdAt                    DateTime                    @default(now())
  updatedAt                    DateTime                    @updatedAt

  @@index([candidateId, createdAt])
  @@index([candidateId, status])
  @@index([placementId, createdAt])
}

model Placement {
  id                    String                 @id @default(cuid())
  candidateId           String
  candidate             Candidate              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  clientId              String?
  client                WorkspaceClient?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName            String
  projectName           String
  startDate             DateTime
  endDate               DateTime?
  /// Daily allocation as a percentage (1–100). 100 = full day on this
  /// client; 50 = half-day, with the other half free to be allocated to
  /// another Placement. Driven by the iOS scheduling view. Open-ended
  /// placements created by the current-client picker default to 100.
  allocationPercent     Int                    @default(100)
  /// Free-text notes attached to this scheduled block (e.g. "Sprint 2
  /// kickoff", "On-call rotation"). Shown in the iOS schedule detail view.
  notes                 String?
  /// Optional link to the specific ClientPlatform (the client's web app, iOS
  /// app, etc.) this dev is engaged on. When set, the scoped-validation
  /// scan uses this platform's repoUrl as the target repo.
  clientPlatformId      String?
  clientPlatform        ClientPlatform?        @relation(fields: [clientPlatformId], references: [id], onDelete: SetNull)
  /// Directory paths inside the platform's repo that the dev is responsible
  /// for. Empty array = whole repo. Used to filter GitHub commits during
  /// the per-engagement scan ("did Shahab actually touch apps/web?"). Each
  /// entry is a literal directory prefix or a simple glob like "apps/web/**".
  repoPaths             String[]               @default([])
  /// Optional branch the dev works on (e.g. "feature/auth-rewrite"). Falls
  /// back to the repo's default branch on the scan side when null.
  repoBranch            String?
  /// Latest scoped scan summary. Lets Pipeline / Portal show a quick
  /// "scanned 3d ago: 6/10 checks pass" badge without an extra query.
  lastScopedScanAt      DateTime?
  lastScopedScanRunId   String?
  lastScopedScanRun     GitHubAnalysisRun?     @relation("PlacementLastScan", fields: [lastScopedScanRunId], references: [id], onDelete: SetNull)
  scopedScanRuns        GitHubAnalysisRun[]    @relation("PlacementScans")
  scopedChecks          CodeClearCheck[]       @relation("PlacementChecks")
  devSignalOutcomeLinks DevSignalOutcomeLink[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @default(now()) @updatedAt

  @@index([candidateId, startDate])
  @@index([clientId])
  @@index([clientPlatformId])
  // Range queries for the schedule endpoints filter on (workspace,) startDate,
  // and endDate. Covered by the existing candidate / client indices.
  @@index([clientId, startDate])
  // Active-placement lookups (`endDate IS NULL`) drive the Portal client cards
  // (cost / dev-count, all clients at once) and the client-detail DEVS tile. A
  // btree on (clientId|candidateId, endDate) serves the IS NULL filter so it never
  // degrades to a full scan as historical placements accumulate.
  @@index([clientId, endDate])
  @@index([candidateId, endDate])
}

model Note {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  body        String
  createdBy   String
  createdAt   DateTime  @default(now())

  @@index([candidateId, createdAt])
}

model ActivityLog {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  eventType   String
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([candidateId, createdAt])
}

model DocumentSection {
  id           String   @id @default(cuid())
  documentId   String
  key          String
  title        String
  description  String?
  sortOrder    Int
  isVisible    Boolean  @default(true)
  data         Json
  // Presenter-only notes shown in presentation mode's notes panel — never rendered in the
  // doc body, public share, or PDF. Optional, additive.
  speakerNotes String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
