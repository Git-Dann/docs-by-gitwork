generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum DocumentType {
  PROPOSAL // Project pitch / scope / costing
  SLA // Service Level Agreement
  SOW // Statement of Work (typically under a parent MSA)
  MSA // Master Service Agreement
  NDA // Non-Disclosure Agreement
  CO // Change Order (against a SOW)
  OTHER // Catch-all for one-offs without a dedicated template yet
}

enum DocumentStatus {
  DRAFT
  PRODUCT_SIGN_OFF
  TECH_SIGN_OFF
  IN_REVIEW
  APPROVED
  SENT
  ARCHIVED
}

enum TimelineView {
  LIST
  MILESTONE
}

enum CostKind {
  ONE_OFF
  RECURRING
}

enum AssetType {
  COVER_IMAGE
  SECTION_GRAPHIC
  DIAGRAM
  LOGO
  SCREENSHOT
}

enum AssetSize {
  SMALL
  MEDIUM
  LARGE
  FULL
}

enum AssetAlignment {
  LEFT
  CENTER
  RIGHT
  FULL
}

enum LinkType {
  INTERNAL_ROUTE
  EXTERNAL_URL
  DECK_LINK
  DOCUMENT_LINK
  EMAIL_LINK
}

enum CTARole {
  PRIMARY
  SECONDARY
}

enum ExportFormat {
  PRINT
  PDF
  SHARE_LINK
}

enum ExportStatus {
  PENDING
  READY
  FAILED
}

enum RateBillingPeriod {
  DAY
  WEEK
  MONTH
}

enum PipelineStatus {
  SOURCED
  INVITED
  ASSESSMENT_IN_PROGRESS
  CODECLEAR_COMPLETE
  PLACED
  RECHECK_DUE
}

enum IdentityConfidence {
  HIGH
  MEDIUM
  LOW
  PENDING
}

enum CodeClearTier {
  TIER_1
  TIER_2
  TIER_3
}

/// Candidate origin — gates Gitwork-team devs from externally sourced devs that
/// will eventually live in a marketplace catalogue. Defaults to INTERNAL so the
/// existing 21 devs auto-tag correctly on migration.
enum CandidateOrigin {
  INTERNAL
  EXTERNAL
}

enum CandidateAvailability {
  AVAILABLE
  ENGAGED
  UNAVAILABLE
}

/// Mirrors PulseCheckStatus — the validation engine and the project-health engine
/// share the same PASS/WARN/FAIL/SKIPPED vocabulary.
enum CodeClearCheckStatus {
  PASS
  WARN
  FAIL
  SKIPPED
}

enum GitHubAnalysisStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum GitHubAnalysisTriggerSource {
  MANUAL
}

model User {
  id                       String                  @id @default(cuid())
  email                    String                  @unique
  name                     String?
  avatarUrl                String?
  passwordHash             String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  memberships              WorkspaceMember[]
  documents                Document[]              @relation("DocumentOwner")
  invitesSent              WorkspaceInvite[]       @relation("InvitesSent")
  invitesAccepted          WorkspaceInvite[]       @relation("InvitesAccepted")
  proofDocuments           ProofDocument[]
  signatureRequestsCreated SignatureRequest[]      @relation("SignatureRequestCreator")
  deviceTokens             DeviceToken[]
  triggeredPulseScans      PulseScan[]             @relation("PulseScanTriggeredBy")
  notificationPreference   NotificationPreference?
  auditLogEntries          AuditLog[]
}

// APNs device registrations. One row per (user, device).
// Push delivery: lookup by userId for personal scans, by workspaceId for monitor scans.
model DeviceToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String    @unique // APNs device token (hex)
  platform    String // "ios" — leaves room for "android"/"web" later
  environment String // "sandbox" | "production" — APNs gateway differs
  appBuild    String? // CFBundleVersion at registration — useful for debugging
  appVersion  String? // CFBundleShortVersionString
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now()) // bumped on every successful push send
  failedAt    DateTime? // set if APNs returns BadDeviceToken/Unregistered — soft delete

  @@index([userId, environment])
  @@index([token])
}

model Workspace {
  id                       String                     @id @default(cuid())
  name                     String
  slug                     String                     @unique
  anthropicApiKey          String?
  anthropicModel           String?
  aiProvider               String                     @default("ANTHROPIC")
  openaiApiKey             String?
  openaiModel              String?
  geminiApiKey             String?
  geminiModel              String?
  localLlmUrl              String?
  localLlmModel            String?
  externalApiKey           String?
  googleServiceAccountJson String?
  googleSubjectEmail       String?
  googleCalendarId         String?
  googleOAuthRefreshToken  String?
  slackBotToken            String?
  slackSummaryChannelId    String? // legacy single-channel — kept for migration
  slackChannels            Json? // Array<{ id: string; name: string }>
  channelRoutes            Json? // { "pulse.alert": "C123", "care.escalation": "C456", ... }
  emailProvider            String? // "RESEND" | "SMTP" | null
  emailApiKey              String? // Resend API key when emailProvider = RESEND
  emailFromAddress         String?
  emailFromName            String?
  emailReplyTo             String?
  emailSmtpHost            String?
  emailSmtpPort            Int?
  emailSmtpUser            String?
  emailSmtpPassword        String?
  branding                 Json? // Cover branding: brandLogoUrl, accents, default confidentiality, etc.
  proposalDefaults         Json? // preparedBy, team, contactDetails, objectiveSnippets
  /// Workspace-wide default rates per CodeClear tier. Shape:
  /// { tier1: { rate, currency, period }, tier2: {...}, tier3: {...} }
  /// Populated by /api/codeclear/admin/tier-defaults; consumed when a
  /// candidate's tier changes (unless RateCardPerson.manualRateOverride).
  tierRateDefaults         Json?
  // ── Public-share branding (P5.19) ───────────────────────────────────
  customHostname           String?                    @unique // Workspace-chosen domain for /docs/[token] (e.g. docs.client.com)
  customHostnameVerified   Boolean                    @default(false)
  customHostnameToken      String? // Random CNAME challenge value for DNS verification
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  members                  WorkspaceMember[]
  invites                  WorkspaceInvite[]
  documents                Document[]
  documentCounters         DocumentCounter[]
  templates                DocumentTemplate[]
  clients                  WorkspaceClient[]
  rateCardPeople           RateCardPerson[]
  proofDocuments           ProofDocument[]
  candidates               Candidate[]
  pulseScans               PulseScan[]
  pulseMonitors            PulseMonitor[]
  supportClients           SupportClient[]
  studies                  Study[]
  agentConfigs             AgentConfig[]
  checkConfigs             PulseCheckConfig[]
  signatureRequests        SignatureRequest[]
  slackWebhooks            SlackWebhookSubscription[]
  auditLogs                AuditLog[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("STAFF")
  permissions Json      @default("[]")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model WorkspaceInvite {
  id           String    @id @default(cuid())
  workspaceId  String
  token        String    @unique @default(cuid())
  label        String?
  status       String    @default("PENDING") // PENDING | ACCEPTED | REVOKED
  invitedById  String
  acceptedById String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy    User      @relation("InvitesSent", fields: [invitedById], references: [id])
  acceptedBy   User?     @relation("InvitesAccepted", fields: [acceptedById], references: [id])
}

model DocumentTemplate {
  id           String       @id @default(cuid())
  workspaceId  String?
  name         String
  slug         String       @unique
  description  String?
  documentType DocumentType @default(PROPOSAL)
  sections     Json
  metadata     Json?
  isDefault    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  documents    Document[]
}

model Document {
  id                String             @id @default(cuid())
  workspaceId       String
  ownerId           String
  templateId        String?
  documentType      DocumentType       @default(PROPOSAL)
  status            DocumentStatus     @default(DRAFT)
  title             String
  productName       String?
  clientName        String?
  clientId          String?
  client            WorkspaceClient?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  summary           String?
  version           String             @default("v1.0")
  expiresAt         DateTime?
  metadata          Json?
  exportSettings    Json?
  // ── Sharing (Sprint 1) ──────────────────────────────────────────────
  shareToken        String?            @unique // Random URL-safe token for /docs/[token]
  isShared          Boolean            @default(false)
  // ── Numbering (Sprint 1) ────────────────────────────────────────────
  documentNumber    String?            @unique // e.g. PROP-2026-014, SLA-2026-003
  // ── Organisation (P0) ───────────────────────────────────────────────
  labels            Json? // Array of workspace-defined label strings (["Q2", "Renewal", …])
  // ── Document relationships (P5) ─────────────────────────────────────
  parentId          String? // Self-ref: SOW under MSA, CO under SOW
  parent            Document?          @relation("DocumentChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children          Document[]         @relation("DocumentChildren")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  archivedAt        DateTime?
  owner             User               @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template          DocumentTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sections          DocumentSection[]
  costLineItems     CostLineItem[]
  timelinePhases    TimelinePhase[]
  assets            Asset[]
  links             Link[]
  ctas              CTA[]
  exports           Export[]
  proofDocuments    ProofDocument[]
  signatureRequests SignatureRequest[]
  views             DocumentView[]
  comments          DocumentComment[]
  versions          DocumentVersion[]
  presence          EditorPresence[]
  aiSession         DocumentAiSession?

  @@index([workspaceId, status])
  @@index([updatedAt])
  @@index([shareToken])
  @@index([parentId])
}

/**
 * Public commenters or workspace operators leave threaded feedback against a document. Public
 * comments arrive via /docs/[token] (anonymous name + email captured per comment). Workspace
 * comments arrive via the editor and are tied to a User. `sectionId` is optional so a comment
 * can attach to a specific section or to the document overall.
 */
enum DocumentCommentAuthorKind {
  PUBLIC // From the share URL — viewer typed a name + email
  WORKSPACE // From the editor — tied to a User
}

enum DocumentCommentStatus {
  OPEN
  RESOLVED
}

model DocumentComment {
  id           String                    @id @default(cuid())
  documentId   String
  sectionId    String? // null = comment on the document as a whole
  parentId     String? // For replies — points to the root comment
  authorKind   DocumentCommentAuthorKind
  authorName   String // Always required — public: typed in form, workspace: User.name
  authorEmail  String? // Required for PUBLIC, optional for WORKSPACE (we have the User)
  authorUserId String? // Set when authorKind = WORKSPACE
  body         String                    @db.Text
  status       DocumentCommentStatus     @default(OPEN)
  createdAt    DateTime                  @default(now())
  resolvedAt   DateTime?
  resolvedBy   String? // User.id who resolved
  document     Document                  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parent       DocumentComment?          @relation("DocumentCommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies      DocumentComment[]         @relation("DocumentCommentReplies")

  @@index([documentId, status, createdAt])
  @@index([documentId, sectionId])
}

/**
 * Frozen snapshot of a document at a particular version bump. Stores everything needed to
 * render the document in a read-only "viewing v1.2" mode and to diff against any other version.
 * Created when the operator clicks "Save version" or bumps the version field in the editor.
 * Independent of the SignatureRequest.documentSnapshot frozen at send-time (which is signing-
 * scoped, not user-driven).
 */
model DocumentVersion {
  id               String   @id @default(cuid())
  documentId       String
  version          String // e.g. "v1.0", "v1.1", "v2.0" — matches Document.version at snapshot time
  /**
   * Full snapshot of the document's sections array at this version.
   */
  sectionsSnapshot Json
  /**
   * Frozen cost line items (denormalized at snapshot time).
   */
  costSnapshot     Json
  /**
   * Frozen timeline phases.
   */
  timelineSnapshot Json
  /**
   * Free-text changelog the operator typed when bumping the version.
   */
  changelog        String?  @db.Text
  createdById      String
  createdAt        DateTime @default(now())
  document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId, createdAt])
}

/**
 * Lightweight presence heartbeats. The editor pings POST /api/documents/[id]/presence every
 * ~8s with a session token; old rows are pruned. A SELECT for rows seen in the last 30s gives
 * the "who's here" list for the avatar bubbles in the editor header.
 * Not a CRDT or real-time channel — just a polling-friendly "saw you" log.
 */
model EditorPresence {
  id         String   @id @default(cuid())
  documentId String
  userId     String? // Null for unauthenticated/system writes; usually populated for workspace operators
  sessionId  String // Browser-tab-scoped UUID
  userName   String // Snapshot for display so we don't join through User
  lastSeenAt DateTime @default(now()) @updatedAt
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, sessionId])
  @@index([documentId, lastSeenAt])
}

/**
 * AI chat conversation persisted per document. One session per (documentId) — when the user
 * reloads the editor, the chat panel hydrates from this row so the conversation history is not
 * lost. The `messages` JSON is an array of `{ id, role: "user" | "assistant", content, proposals?}`
 * objects that mirror the in-memory shape used by the AiChatPanel component.
 *
 * We don't store full proposal diffs in `messages` — accepted proposals are already applied to
 * the document; rejected proposals fade away on the client. Only the prose turn-by-turn record
 * is preserved so future turns can keep context.
 */
model DocumentAiSession {
  id          String   @id @default(cuid())
  documentId  String   @unique
  messages    Json     // Array<{ id: string; role: "user" | "assistant"; content: string; createdAt: string }>
  updatedAt   DateTime @default(now()) @updatedAt
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

/**
 * Audit row for each visit to a document's public share URL or signing URL. Powers the view
 * count + last-viewed-at displays in the editor's sidebar, and feeds the activity feed.
 * Recorded by the public pages via fire-and-forget POSTs. `signerId` is set when the visit
 * originated from /sign/[token]; null otherwise (visits to /docs/[token]).
 */
model DocumentView {
  id         String           @id @default(cuid())
  documentId String
  signerId   String?
  ip         String?
  userAgent  String?          @db.Text
  referer    String?
  /**
   * Origin of the view — DOCS for /docs/[token], SIGN for /sign/[token].
   */
  origin     String           @default("DOCS")
  createdAt  DateTime         @default(now())
  document   Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signer     SignatureSigner? @relation(fields: [signerId], references: [id], onDelete: SetNull)

  @@index([documentId, createdAt])
}

// Per-workspace + per-doc-type + per-year counter for atomic document numbering.
// e.g. workspaceId=W1, documentType=PROPOSAL, year=2026, nextValue=15
//      → next created proposal in 2026 gets PROP-2026-015
model DocumentCounter {
  id           String       @id @default(cuid())
  workspaceId  String
  documentType DocumentType
  year         Int
  nextValue    Int          @default(1)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, documentType, year])
  @@index([workspaceId, documentType])
}

// ── E-signature (Sprint 4) ──────────────────────────────────────────────────────────────────

enum SignatureRequestStatus {
  DRAFT // Request created but not yet sent — workspace can still edit
  SENT // Awaiting signatures
  COMPLETED // All signers signed
  DECLINED // At least one signer declined
  REVOKED // Workspace revoked the request before completion
  EXPIRED // Request passed its expiresAt without completing
}

enum SignatureSignerStatus {
  PENDING // Invited, not yet viewed
  VIEWED // Opened the signing page at least once
  SIGNED
  DECLINED
}

enum SignatureCaptureMethod {
  DRAWN // Canvas / stylus / mouse — stored as PNG data URL
  TYPED // Stylised typed name — stored as the typed string + chosen font
}

enum SignatureEventKind {
  REQUEST_CREATED
  REQUEST_SENT
  REQUEST_REVOKED
  REQUEST_EXPIRED
  REQUEST_COMPLETED
  SIGNER_INVITED
  SIGNER_VIEWED
  SIGNER_SIGNED
  SIGNER_DECLINED
}

/// A single "send for signature" event tied to a document. Carries the signers, status, and an
/// immutable snapshot of the document at send-time (so subsequent edits to the doc don't change
/// what someone is signing).
model SignatureRequest {
  id               String                 @id @default(cuid())
  documentId       String
  workspaceId      String
  createdById      String
  status           SignatureRequestStatus @default(DRAFT)
  message          String?                @db.Text
  expiresAt        DateTime?
  sentAt           DateTime?
  completedAt      DateTime?
  /// JSON snapshot of the document at the moment the request was SENT. Used by the public
  /// /sign/[token] page so subsequent edits don't change what's being signed. Null while the
  /// request is still DRAFT.
  documentSnapshot Json?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  document         Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  workspace        Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy        User                   @relation("SignatureRequestCreator", fields: [createdById], references: [id], onDelete: Cascade)
  signers          SignatureSigner[]
  events           SignatureEvent[]

  @@index([documentId, status])
  @@index([workspaceId, status])
}

/// One signatory on a SignatureRequest. The `accessToken` is what gates /sign/[token] — minted
/// when the request flips from DRAFT to SENT. Once signed, the row carries the captured
/// signature, signer-stated name, IP, and UA for audit.
model SignatureSigner {
  id               String                  @id @default(cuid())
  requestId        String
  /// Order key for sequential signing flows. Null for parallel signing (v1 default).
  signingOrder     Int?
  name             String
  email            String
  role             String
  organization     String?
  /// Mirror of the signature block the parties/signatures section produced. Used to render the
  /// right block in the signed PDF.
  signatureBlockId String?
  accessToken      String                  @unique
  status           SignatureSignerStatus   @default(PENDING)
  signedAt         DateTime?
  declinedAt       DateTime?
  declineReason    String?
  signatureMethod  SignatureCaptureMethod?
  /// Signature payload. For DRAWN: PNG data URL (base64). For TYPED: the typed string.
  signaturePayload String?                 @db.Text
  /// The name the signer typed in the consent box — kept separate from `name` (which is the
  /// invite recipient's name) so we have an auditable record of what they declared.
  signedName       String?
  /// Optional font key for TYPED signatures (e.g. "caveat", "great-vibes").
  signedFontKey    String?
  signedIp         String?
  signedUserAgent  String?                 @db.Text
  invitedAt        DateTime?
  firstViewedAt    DateTime?
  request          SignatureRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  events           SignatureEvent[]
  documentViews    DocumentView[]

  @@index([requestId, signingOrder])
}

/// Append-only audit log for the entire signature lifecycle. Every view / send / sign / revoke
/// creates a row. Used by the Certificate of Completion appendix and any compliance export.
model SignatureEvent {
  id        String             @id @default(cuid())
  requestId String
  signerId  String?
  kind      SignatureEventKind
  ip        String?
  userAgent String?            @db.Text
  metadata  Json?
  createdAt DateTime           @default(now())
  request   SignatureRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  signer    SignatureSigner?   @relation(fields: [signerId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
}

/**
 * Workspace-level Slack webhook subscriptions (P5). One row per (workspace × event class)
 * pairing. When the matching event fires (doc viewed, signed, completed, comment added), the
 * server POSTs a formatted Slack Block Kit message to `webhookUrl`.
 * Distinct from Workspace.slackBotToken (which authenticates a full Slack bot for the meeting-
 * summary feature) — webhooks are simpler and per-event-class.
 */
enum DocumentEventKind {
  DOC_SHARED // Workspace minted a share link
  DOC_VIEWED // Public visitor opened the share URL
  DOC_SENT // Sent for signature
  DOC_SIGNED // A signer signed
  DOC_COMPLETED // All signers signed
  DOC_DECLINED // A signer declined
  COMMENT_ADDED // Public or workspace comment added
}

model SlackWebhookSubscription {
  id          String    @id @default(cuid())
  workspaceId String
  label       String // Operator-facing label ("#proposals notifications")
  webhookUrl  String    @db.Text
  eventKinds  Json // Array<DocumentEventKind>
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, enabled])
}

model ProofDocument {
  id           String    @id @default(cuid())
  workspaceId  String
  ownerId      String
  proposalId   String?
  title        String
  markdown     String?
  slug         String    @unique
  shareUrl     String
  tokenUrl     String
  accessToken  String
  source       String    @default("proof")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastOpenedAt DateTime  @default(now())
  archivedAt   DateTime?
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  proposal     Document? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@index([workspaceId, lastOpenedAt])
  @@index([proposalId, lastOpenedAt])
}

model WorkspaceClient {
  id                   String           @id @default(cuid())
  workspaceId          String
  name                 String
  slug                 String
  logoUrl              String?
  website              String?
  addressLine1         String?
  addressLine2         String?
  city                 String?
  postcode             String?
  country              String?
  notes                String?          @db.Text
  primaryContactName   String?
  primaryContactEmail  String?
  primaryContactPhone  String?
  googleDriveFolderUrl String?
  hidden               Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  workspace            Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pulseScans           PulseScan[]
  platforms            ClientPlatform[]
  documents            Document[]
  supportClients       SupportClient[]
  placements           Placement[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, name])
  @@map("Client")
}

model ClientPlatform {
  id           String          @id @default(cuid())
  clientId     String
  client       WorkspaceClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name         String
  platformType String?
  url          String?
  stagingUrl   String?
  repoUrl      String?
  credentials  String?         @db.Text
  notes        String?         @db.Text
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([clientId])
  @@map("ClientPlatform")
}

model Candidate {
  id                 String                 @id @default(cuid())
  workspaceId        String
  rateCardPersonId   String?
  name               String
  githubHandle       String
  email              String?
  primaryStack       String
  techStacks         String[]               @default([])
  signalSources      String[]               @default([])
  location           String?
  bio                String?
  status             PipelineStatus         @default(SOURCED)
  /// Derived tier (see codeclear-scoring.ts deriveTier). Persisted as a
  /// snapshot for cheap reads / SQL filters; rebuilt whenever the score
  /// changes. Effective tier in the UI = tierManualOverride ?? tier.
  tier               CodeClearTier          @default(TIER_3)
  /// Admin escape hatch — when set, the UI shows this tier instead of the
  /// derived one. We never overwrite the derived value, so we can show
  /// "Override (was Tier 2)" in the drawer.
  tierManualOverride CodeClearTier?
  /// INTERNAL = a Gitwork team member. EXTERNAL = sourced for the marketplace.
  /// Existing rows default to INTERNAL so nothing changes for current devs.
  origin             CandidateOrigin        @default(INTERNAL)
  /// Reserved flag for the future marketplace — flips a dev from "in
  /// validation" to "available to clients". Does nothing yet client-side.
  published          Boolean                @default(false)
  avatarUrl          String?
  linkedinUrl        String?
  cvUrl              String?
  portfolioUrl       String?
  yearsExperience    Int?
  hourlyRate         Decimal?               @db.Decimal(10, 2)
  currency           String?                @db.VarChar(3)
  timezone           String?
  /// User-overridable availability. When null, derive from open Placement
  /// (open placement → ENGAGED, otherwise AVAILABLE).
  availability       CandidateAvailability?
  recheckDueAt       DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  workspace          Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rateCardPerson     RateCardPerson?        @relation(fields: [rateCardPersonId], references: [id], onDelete: SetNull)
  score              CodeClearScore?
  scoreDraft         CodeClearScoreDraft?
  githubAnalysisRuns GitHubAnalysisRun[]
  checks             CodeClearCheck[]
  placements         Placement[]
  notes              Note[]
  activityLog        ActivityLog[]

  @@unique([workspaceId, githubHandle])
  @@index([workspaceId, status])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, recheckDueAt])
  @@index([workspaceId, origin, published])
}

/// One row per validation finding. Mirrors PulseScanCheck. The most recent run
/// is the source of truth; older check rows hang around for audit.
model CodeClearCheck {
  id          String               @id @default(cuid())
  candidateId String
  candidate   Candidate            @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  runId       String?
  run         GitHubAnalysisRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)
  category    String
  checkKey    String
  label       String
  status      CodeClearCheckStatus
  detail      String?
  evidence    String?
  weight      Int                  @default(1)
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())

  @@index([candidateId, category])
  @@index([candidateId, sortOrder])
  @@index([runId])
}

/// Curated list of tech stacks. Replaces the hard-coded TECH_STACK_OPTIONS so
/// admins can add stacks without a deploy. Seeded on first migration.
model TechStack {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String?
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model CodeClearScore {
  id                 String             @id @default(cuid())
  candidateId        String             @unique
  candidate          Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  technicalDepth     Int                @default(0)
  codeQuality        Int                @default(0)
  aiFluency          Int                @default(0)
  deliveryReadiness  Int                @default(0)
  identityConfidence IdentityConfidence @default(PENDING)
  overallScore       Int                @default(0)
  taskScore          Int?
  taskTimeSeconds    Int?
  taskAiReview       String?
  verifiedAt         DateTime?
  validUntil         DateTime?
  reminderSentAt     DateTime?
  expiredAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model CodeClearScoreDraft {
  id                 String              @id @default(cuid())
  candidateId        String              @unique
  candidate          Candidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  technicalDepth     Int?
  codeQuality        Int?
  aiFluency          Int?
  deliveryReadiness  Int?
  identityConfidence IdentityConfidence?
  overallScore       Int?
  taskScore          Int?
  taskTimeSeconds    Int?
  taskAiReview       String?
  sourceRunId        String?
  sourceRun          GitHubAnalysisRun?  @relation("GitHubAnalysisRunDraftSource", fields: [sourceRunId], references: [id], onDelete: SetNull)
  lastAppliedAt      DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model GitHubAnalysisRun {
  id                           String                      @id @default(cuid())
  candidateId                  String
  candidate                    Candidate                   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  drafts                       CodeClearScoreDraft[]       @relation("GitHubAnalysisRunDraftSource")
  checks                       CodeClearCheck[]
  status                       GitHubAnalysisStatus        @default(RUNNING)
  triggerSource                GitHubAnalysisTriggerSource @default(MANUAL)
  analysisVersion              String
  startedAt                    DateTime                    @default(now())
  completedAt                  DateTime?
  profileSnapshot              Json?
  repoSnapshot                 Json?
  metrics                      Json?
  redFlags                     Json?
  recommendedTechnicalDepth    Int?
  recommendedCodeQuality       Int?
  recommendedDeliveryReadiness Int?
  llmSummary                   String?
  errorCode                    String?
  errorMessage                 String?
  createdAt                    DateTime                    @default(now())
  updatedAt                    DateTime                    @updatedAt

  @@index([candidateId, createdAt])
  @@index([candidateId, status])
}

model Placement {
  id          String           @id @default(cuid())
  candidateId String
  candidate   Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  clientId    String?
  client      WorkspaceClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName  String
  projectName String
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime         @default(now())

  @@index([candidateId, startDate])
  @@index([clientId])
}

model Note {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  body        String
  createdBy   String
  createdAt   DateTime  @default(now())

  @@index([candidateId, createdAt])
}

model ActivityLog {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  eventType   String
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([candidateId, createdAt])
}

model DocumentSection {
  id          String   @id @default(cuid())
  documentId  String
  key         String
  title       String
  description String?
  sortOrder   Int
  isVisible   Boolean  @default(true)
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  assets      Asset[]

  @@index([documentId, sortOrder])
}

model CostLineItem {
  id          String   @id @default(cuid())
  documentId  String
  category    String
  itemName    String
  description String?
  quantity    Decimal  @db.Decimal(12, 2)
  unitCost    Decimal  @db.Decimal(12, 2)
  subtotal    Decimal  @db.Decimal(12, 2)
  costKind    CostKind @default(ONE_OFF)
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, sortOrder])
}

model TimelinePhase {
  id           String       @id @default(cuid())
  documentId   String
  name         String
  duration     String
  summary      String
  deliverables Json
  sortOrder    Int
  viewMode     TimelineView @default(LIST)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, sortOrder])
}

model Asset {
  id         String           @id @default(cuid())
  documentId String
  sectionId  String?
  type       AssetType
  title      String
  url        String
  altText    String
  placement  String
  caption    String?
  size       AssetSize        @default(MEDIUM)
  alignment  AssetAlignment   @default(LEFT)
  sortOrder  Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  document   Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  section    DocumentSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([documentId, placement])
}

model Link {
  id         String   @id @default(cuid())
  documentId String
  label      String
  url        String
  type       LinkType
  notes      String?
  sortOrder  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, sortOrder])
}

model CTA {
  id              String   @id @default(cuid())
  documentId      String
  role            CTARole
  label           String
  destination     String
  destinationType LinkType
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, role])
}

model Export {
  id          String       @id @default(cuid())
  documentId  String
  format      ExportFormat
  status      ExportStatus @default(PENDING)
  url         String?
  settings    Json?
  requestedAt DateTime     @default(now())
  completedAt DateTime?
  document    Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, requestedAt])
}

model RateCardPerson {
  id                 String            @id @default(cuid())
  workspaceId        String
  seedIdentifier     String?
  name               String
  area               String
  /// Pricing tier — when set, the rate can be auto-populated from the
  /// workspace-level tierRateDefaults unless manualRateOverride is true.
  tier               CodeClearTier?
  /// When true, sourceRate is hand-set by an admin and won't be overwritten
  /// when the candidate's derived tier changes.
  manualRateOverride Boolean           @default(false)
  sourceRate         Decimal           @db.Decimal(12, 2)
  sourceCurrencyCode String
  billingPeriod      RateBillingPeriod @default(MONTH)
  archivedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  workspace          Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  candidates         Candidate[]

  @@unique([workspaceId, seedIdentifier])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, archivedAt])
  @@index([workspaceId, tier])
}

enum PulseScanStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum PulseScanInputType {
  URL
  GITHUB_REPO
  FREE_TEXT
}

enum PulseCheckStatus {
  PASS
  WARN
  FAIL
  SKIPPED
}

model PulseScan {
  id                  String             @id @default(cuid())
  workspaceId         String
  workspace           Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId            String?
  client              WorkspaceClient?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  triggeredByUserId   String? // null = monitor/webhook-triggered. Used by push to attribute scans to the user who started them.
  triggeredByUser     User?              @relation("PulseScanTriggeredBy", fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  projectName         String
  inputType           PulseScanInputType
  inputUrl            String?
  inputGithubRepo     String?
  inputDescription    String?
  platform            String?
  status              PulseScanStatus    @default(RUNNING)
  scanVersion         String
  startedAt           DateTime           @default(now())
  completedAt         DateTime?
  healthScore         Int?
  previousHealthScore Int?
  techStack           Json?
  llmAnalysis         Json?
  discoveryData       Json? // DiscoveryKit — discovery call intelligence
  agentData           Json? // { codeInsights, deployInsights } from agent pipeline
  competitorUrls      Json? // string[] — optional competitor URLs to benchmark
  competitorData      Json? // CompetitorData — parallel scan results + AI comparison
  shareToken          String?            @unique
  isShared            Boolean            @default(false)
  errorCode           String?
  errorMessage        String?
  generatedProposalId String?
  checks              PulseScanCheck[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([clientId, createdAt])
  @@index([shareToken])
}

model PulseMonitor {
  id              String             @id @default(cuid())
  workspaceId     String
  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectName     String
  inputType       PulseScanInputType
  inputUrl        String?
  inputGithubRepo String?
  clientId        String?
  webhookSecret   String             @unique @default(cuid())
  lastScanId      String?
  lastHealthScore Int?
  alertThreshold  Int                @default(10) // score drop that triggers alert
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([workspaceId])
  @@index([webhookSecret])
  @@index([inputGithubRepo])
  @@index([inputUrl])
}

model PulseScanCheck {
  id        String           @id @default(cuid())
  scanId    String
  scan      PulseScan        @relation(fields: [scanId], references: [id], onDelete: Cascade)
  category  String
  checkKey  String
  label     String
  status    PulseCheckStatus
  detail    String?
  evidence  String?
  sortOrder Int
  createdAt DateTime         @default(now())

  @@index([scanId, category])
  @@index([scanId, sortOrder])
}

// ─── Support Ops ──────────────────────────────────────────────────────────────

enum SupportClientStatus {
  ACTIVE
  INACTIVE
}

enum SupportSource {
  GMAIL
  REDDIT
  INSTAGRAM
  YOUTUBE
  DISCORD
  CLICKUP
  STRIPE
}

enum ConnectionHealth {
  CONNECTED
  NEEDS_SETUP
  ERROR
}

enum ConnectionAuthMode {
  OAUTH
  BOT_TOKEN
  MANUAL
  API_KEY
}

enum ConversationSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  DEV_REVIEW
  AWAITING_CUSTOMER
  RESOLVED
}

enum SupportTicketPriority {
  URGENT
  HIGH
  NORMAL
  LOW
}

enum DraftActionType {
  REPLY
  STRIPE_CANCEL
  STRIPE_REFUND
}

enum DraftActionStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
}

enum DraftActionRisk {
  LOW
  MEDIUM
  HIGH
}

enum SupportUserRole {
  OWNER
  STAFF
}

model SupportClient {
  id                  String                    @id @default(cuid())
  workspaceId         String
  workspace           Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                String
  slug                String
  status              SupportClientStatus       @default(ACTIVE)
  supportDaysPerMonth Int?
  supportDaysUsed     Int?                      @default(0)
  reportingRecipient  String?
  reportDueDay        Int?
  workspaceClientId   String?
  workspaceClient     WorkspaceClient?          @relation(fields: [workspaceClientId], references: [id], onDelete: SetNull)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  connections         AccountConnection[]
  conversations       SupportConversation[]
  tickets             SupportTicket[]
  draftActions        DraftSupportAction[]
  workflowRules       SupportWorkflowRule[]
  auditLogs           SupportAuditLog[]
  memberships         SupportClientMembership[]
  reports             SupportReport[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model SupportClientMembership {
  id        String          @id @default(cuid())
  clientId  String
  client    SupportClient   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String
  role      SupportUserRole @default(STAFF)
  createdAt DateTime        @default(now())

  @@unique([clientId, userId])
  @@index([clientId])
}

model AccountConnection {
  id            String             @id @default(cuid())
  clientId      String
  client        SupportClient      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  source        SupportSource
  label         String
  authMode      ConnectionAuthMode
  health        ConnectionHealth   @default(NEEDS_SETUP)
  secretRef     String?
  scraperConfig Json?
  nextStep      String?
  lastSyncedAt  DateTime?
  syncCursor    String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  channelTokens ChannelToken[]

  @@index([clientId, source])
}

model ChannelToken {
  id           String            @id @default(cuid())
  connectionId String
  connection   AccountConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  tokenData    Json
  expiresAt    DateTime?
  lastUsedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([connectionId])
}

model CustomerIdentity {
  id             String   @id @default(cuid())
  clientId       String
  externalIdHash String
  displayLabel   String
  createdAt      DateTime @default(now())

  @@unique([clientId, externalIdHash])
  @@index([clientId])
}

model SupportConversation {
  id            String                @id @default(cuid())
  clientId      String
  client        SupportClient         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  source        SupportSource
  customerLabel String
  externalId    String?
  subject       String
  preview       String?
  unread        Boolean               @default(true)
  tags          String[]              @default([])
  sentiment     ConversationSentiment @default(NEUTRAL)
  receivedAt    DateTime
  createdAt     DateTime              @default(now())
  messages      SupportMessage[]
  tickets       SupportTicket[]

  @@index([clientId, receivedAt])
  @@index([clientId, unread])
}

model SupportMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String
  authorLabel    String
  body           String
  externalId     String?
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
  @@index([conversationId, externalId])
}

model SupportTicket {
  id             String                @id @default(cuid())
  clientId       String
  client         SupportClient         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   SupportConversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  title          String
  customerLabel  String
  status         SupportTicketStatus   @default(OPEN)
  priority       SupportTicketPriority @default(NORMAL)
  source         SupportSource
  nextAction     String?
  issueType      String?
  assignedTo     String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  draftActions   DraftSupportAction[]

  @@index([clientId, status])
  @@index([clientId, updatedAt])
}

model DraftSupportAction {
  id         String            @id @default(cuid())
  clientId   String
  client     SupportClient     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ticketId   String?
  ticket     SupportTicket?    @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  type       DraftActionType
  title      String
  body       String
  status     DraftActionStatus @default(PENDING_APPROVAL)
  risk       DraftActionRisk   @default(LOW)
  approvedBy String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([clientId, status])
  @@index([ticketId])
}

model SupportWorkflowRule {
  id               String        @id @default(cuid())
  clientId         String
  client           SupportClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name             String
  triggerText      String
  actionsText      String
  requiresApproval Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([clientId])
}

model SupportReport {
  id        String        @id @default(cuid())
  clientId  String
  client    SupportClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  period    String
  payload   Json?
  createdBy String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([clientId, period])
}

model SupportAuditLog {
  id        String        @id @default(cuid())
  clientId  String
  client    SupportClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actorId   String?
  action    String
  target    String?
  metadata  Json?
  createdAt DateTime      @default(now())

  @@index([clientId, createdAt])
}

// ─── Study / Research ────────────────────────────────────────────────────────

enum StudyStatus {
  DRAFT
  PLAN_GENERATING
  PLAN_READY
  RUNNING
  COMPLETED
  FAILED
}

enum StudySessionMode {
  ONE_ON_ONE
  GROUP
}

enum StudyPlanStatus {
  DRAFT
  GENERATING
  READY
  LOCKED
}

enum StudyTurnType {
  SINGLE
  SEQUENCED_FLOW
}

enum StudySessionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model Study {
  id                 String             @id @default(cuid())
  workspaceId        String
  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title              String
  problemStatement   String
  researchGoals      String[]           @default([])
  status             StudyStatus        @default(DRAFT)
  sessionMode        StudySessionMode   @default(ONE_ON_ONE)
  selectedPersonaIds String[]           @default([])
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  plan               StudyResearchPlan?
  sessions           StudySession[]
  report             StudyReport?

  @@index([workspaceId, createdAt])
}

model StudyResearchPlan {
  id        String              @id @default(cuid())
  studyId   String              @unique
  study     Study               @relation(fields: [studyId], references: [id], onDelete: Cascade)
  notes     String?
  status    StudyPlanStatus     @default(DRAFT)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  questions StudyPlanQuestion[]
}

model StudyPlanQuestion {
  id         String            @id @default(cuid())
  planId     String
  plan       StudyResearchPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  text       String
  personaIds String[]          @default([])
  turnType   StudyTurnType     @default(SINGLE)
  orderIndex Int
  rationale  String?
  createdAt  DateTime          @default(now())

  @@index([planId, orderIndex])
}

model StudySession {
  id             String             @id @default(cuid())
  studyId        String
  study          Study              @relation(fields: [studyId], references: [id], onDelete: Cascade)
  personaId      String
  personaName    String
  mode           StudySessionMode   @default(ONE_ON_ONE)
  status         StudySessionStatus @default(PENDING)
  transcriptData Json?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([studyId, status])
}

model StudyReport {
  id        String   @id @default(cuid())
  studyId   String   @unique
  study     Study    @relation(fields: [studyId], references: [id], onDelete: Cascade)
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Agent & Check Configuration ────────────────────────────────────────────

model AgentConfig {
  id                   String    @id @default(cuid())
  workspaceId          String
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentKey             String // e.g. "pulse:synthesis", "study:researcher"
  product              String // "pulse" | "study"
  enabled              Boolean   @default(true)
  systemPromptOverride String?   @db.Text
  modelOverride        String?
  configJson           Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([workspaceId, agentKey])
  @@index([workspaceId])
}

model PulseCheckConfig {
  id               String    @id @default(cuid())
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  checkKey         String // matches hardcoded checkKey, or cuid() for custom checks
  enabled          Boolean   @default(true)
  labelOverride    String?
  severityOverride String? // "WARN" | "FAIL" — downgrade/upgrade threshold
  isCustom         Boolean   @default(false)
  customConfig     Json? // for custom checks: { type, pattern, url, expected, ... }
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([workspaceId, checkKey])
  @@index([workspaceId])
}

// Per-user notification preferences. One row per user.
// `events` shape: { [eventKey: string]: ("email" | "push" | "slack" | "inApp")[] }
// `digestCadence`: OFF | DAILY | WEEKLY
model NotificationPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled    Boolean  @default(true)
  pushEnabled     Boolean  @default(true)
  slackEnabled    Boolean  @default(false)
  inAppEnabled    Boolean  @default(true)
  events          Json     @default("{}")
  digestCadence   String   @default("OFF")
  quietHoursStart String? // "22:00" — 24h HH:mm, workspace timezone
  quietHoursEnd   String? // "07:00"
  timezone        String? // IANA tz, e.g. "Europe/London"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Workspace-scoped audit trail. Recorded by `recordAuditEntry()` for critical actions
// (settings changes, key rotations, role changes, integration connect/disconnect).
model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action      String // e.g. "settings.ai_provider.changed", "team.member.invited"
  target      String? // resource identifier (e.g. "workspace:aiProvider", "user:abc123")
  before      Json? // previous value (omit for create events)
  after       Json? // new value (omit for delete events)
  metadata    Json? // free-form context (ip, userAgent, source)
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@index([action])
  @@index([actorId])
}
