generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum DocumentType {
  PROPOSAL
  SLA
  OTHER
}

enum DocumentStatus {
  DRAFT
  PRODUCT_SIGN_OFF
  TECH_SIGN_OFF
  IN_REVIEW
  APPROVED
  SENT
  ARCHIVED
}

enum TimelineView {
  LIST
  MILESTONE
}

enum CostKind {
  ONE_OFF
  RECURRING
}

enum AssetType {
  COVER_IMAGE
  SECTION_GRAPHIC
  DIAGRAM
  LOGO
  SCREENSHOT
}

enum AssetSize {
  SMALL
  MEDIUM
  LARGE
  FULL
}

enum AssetAlignment {
  LEFT
  CENTER
  RIGHT
  FULL
}

enum LinkType {
  INTERNAL_ROUTE
  EXTERNAL_URL
  DECK_LINK
  DOCUMENT_LINK
  EMAIL_LINK
}

enum CTARole {
  PRIMARY
  SECONDARY
}

enum ExportFormat {
  PRINT
  PDF
  SHARE_LINK
}

enum ExportStatus {
  PENDING
  READY
  FAILED
}

enum RateBillingPeriod {
  DAY
  WEEK
  MONTH
}

enum PipelineStatus {
  SOURCED
  INVITED
  ASSESSMENT_IN_PROGRESS
  CODECLEAR_COMPLETE
  PLACED
  RECHECK_DUE
}

enum IdentityConfidence {
  HIGH
  MEDIUM
  LOW
  PENDING
}

enum CodeClearTier {
  TIER_1
  TIER_2
  TIER_3
}

enum GitHubAnalysisStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum GitHubAnalysisTriggerSource {
  MANUAL
}

model User {
  id          String            @id @default(cuid())
  email       String            @unique
  name        String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  memberships WorkspaceMember[]
  documents   Document[]        @relation("DocumentOwner")
  proofDocuments ProofDocument[]
}

model Workspace {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  anthropicApiKey String?
  anthropicModel  String?
  aiProvider      String   @default("ANTHROPIC")
  openaiApiKey    String?
  openaiModel     String?
  geminiApiKey    String?
  geminiModel     String?
  localLlmUrl     String?
  localLlmModel   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  members         WorkspaceMember[]
  documents       Document[]
  templates       DocumentTemplate[]
  clients         WorkspaceClient[]
  rateCardPeople  RateCardPerson[]
  proofDocuments  ProofDocument[]
  candidates      Candidate[]
  pulseScans      PulseScan[]
  pulseMonitors   PulseMonitor[]
  supportClients  SupportClient[]
  studies         Study[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("OWNER")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model DocumentTemplate {
  id           String       @id @default(cuid())
  workspaceId  String?
  name         String
  slug         String       @unique
  description  String?
  documentType DocumentType @default(PROPOSAL)
  sections     Json
  metadata     Json?
  isDefault    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  documents    Document[]
}

model Document {
  id             String          @id @default(cuid())
  workspaceId    String
  ownerId        String
  templateId     String?
  documentType   DocumentType    @default(PROPOSAL)
  status         DocumentStatus  @default(DRAFT)
  title          String
  productName    String?
  clientName     String?
  summary        String?
  version        String          @default("v1.0")
  expiresAt      DateTime?
  metadata       Json?
  exportSettings Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  archivedAt     DateTime?
  owner          User            @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template       DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sections       DocumentSection[]
  costLineItems  CostLineItem[]
  timelinePhases TimelinePhase[]
  assets         Asset[]
  links          Link[]
  ctas           CTA[]
  exports        Export[]
  proofDocuments ProofDocument[]

  @@index([workspaceId, status])
  @@index([updatedAt])
}

model ProofDocument {
  id           String    @id @default(cuid())
  workspaceId  String
  ownerId      String
  proposalId   String?
  title        String
  markdown     String?
  slug         String    @unique
  shareUrl     String
  tokenUrl     String
  accessToken  String
  source       String    @default("proof")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastOpenedAt DateTime  @default(now())
  archivedAt   DateTime?
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  proposal     Document? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@index([workspaceId, lastOpenedAt])
  @@index([proposalId, lastOpenedAt])
}

model WorkspaceClient {
  id          String      @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  logoUrl     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pulseScans  PulseScan[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, name])
  @@map("Client")
}

model Candidate {
  id               String         @id @default(cuid())
  workspaceId      String
  rateCardPersonId String?
  name             String
  githubHandle     String
  email            String?
  primaryStack     String
  techStacks       String[]       @default([])
  signalSources    String[]       @default([])
  location         String?
  bio              String?
  status           PipelineStatus @default(SOURCED)
  tier             CodeClearTier  @default(TIER_1)
  avatarUrl        String?
  recheckDueAt     DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rateCardPerson   RateCardPerson? @relation(fields: [rateCardPersonId], references: [id], onDelete: SetNull)
  score            CodeClearScore?
  scoreDraft       CodeClearScoreDraft?
  githubAnalysisRuns GitHubAnalysisRun[]
  placements       Placement[]
  notes            Note[]
  activityLog      ActivityLog[]

  @@unique([workspaceId, githubHandle])
  @@index([workspaceId, status])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, recheckDueAt])
}

model CodeClearScore {
  id                 String             @id @default(cuid())
  candidateId        String             @unique
  candidate          Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  technicalDepth     Int                @default(0)
  codeQuality        Int                @default(0)
  aiFluency          Int                @default(0)
  deliveryReadiness  Int                @default(0)
  identityConfidence IdentityConfidence @default(PENDING)
  overallScore       Int                @default(0)
  taskScore          Int?
  taskTimeSeconds    Int?
  taskAiReview       String?
  verifiedAt         DateTime?
  validUntil         DateTime?
  reminderSentAt     DateTime?
  expiredAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model CodeClearScoreDraft {
  id                 String              @id @default(cuid())
  candidateId        String              @unique
  candidate          Candidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  technicalDepth     Int?
  codeQuality        Int?
  aiFluency          Int?
  deliveryReadiness  Int?
  identityConfidence IdentityConfidence?
  overallScore       Int?
  taskScore          Int?
  taskTimeSeconds    Int?
  taskAiReview       String?
  sourceRunId        String?
  sourceRun          GitHubAnalysisRun?  @relation("GitHubAnalysisRunDraftSource", fields: [sourceRunId], references: [id], onDelete: SetNull)
  lastAppliedAt      DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model GitHubAnalysisRun {
  id                           String                      @id @default(cuid())
  candidateId                  String
  candidate                    Candidate                   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  drafts                       CodeClearScoreDraft[]       @relation("GitHubAnalysisRunDraftSource")
  status                       GitHubAnalysisStatus        @default(RUNNING)
  triggerSource                GitHubAnalysisTriggerSource @default(MANUAL)
  analysisVersion              String
  startedAt                    DateTime                    @default(now())
  completedAt                  DateTime?
  profileSnapshot              Json?
  repoSnapshot                 Json?
  metrics                      Json?
  redFlags                     Json?
  recommendedTechnicalDepth    Int?
  recommendedCodeQuality       Int?
  recommendedDeliveryReadiness Int?
  llmSummary                   String?
  errorCode                    String?
  errorMessage                 String?
  createdAt                    DateTime                    @default(now())
  updatedAt                    DateTime                    @updatedAt

  @@index([candidateId, createdAt])
  @@index([candidateId, status])
}

model Placement {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  clientName  String
  projectName String
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime  @default(now())

  @@index([candidateId, startDate])
}

model Note {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  body        String
  createdBy   String
  createdAt   DateTime  @default(now())

  @@index([candidateId, createdAt])
}

model ActivityLog {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  eventType   String
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([candidateId, createdAt])
}

model DocumentSection {
  id          String   @id @default(cuid())
  documentId  String
  key         String
  title       String
  description String?
  sortOrder   Int
  isVisible   Boolean  @default(true)
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  assets      Asset[]

  @@index([documentId, sortOrder])
}

model CostLineItem {
  id          String   @id @default(cuid())
  documentId  String
  category    String
  itemName    String
  description String?
  quantity    Decimal  @db.Decimal(12, 2)
  unitCost    Decimal  @db.Decimal(12, 2)
  subtotal    Decimal  @db.Decimal(12, 2)
  costKind    CostKind @default(ONE_OFF)
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, sortOrder])
}

model TimelinePhase {
  id          String       @id @default(cuid())
  documentId  String
  name        String
  duration    String
  summary     String
  deliverables Json
  sortOrder   Int
  viewMode    TimelineView @default(LIST)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  document    Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, sortOrder])
}

model Asset {
  id         String         @id @default(cuid())
  documentId String
  sectionId  String?
  type       AssetType
  title      String
  url        String
  altText    String
  placement  String
  caption    String?
  size       AssetSize      @default(MEDIUM)
  alignment  AssetAlignment @default(LEFT)
  sortOrder  Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  document   Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  section    DocumentSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([documentId, placement])
}

model Link {
  id         String   @id @default(cuid())
  documentId String
  label      String
  url        String
  type       LinkType
  notes      String?
  sortOrder  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, sortOrder])
}

model CTA {
  id              String   @id @default(cuid())
  documentId      String
  role            CTARole
  label           String
  destination     String
  destinationType LinkType
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, role])
}

model Export {
  id          String       @id @default(cuid())
  documentId  String
  format      ExportFormat
  status      ExportStatus @default(PENDING)
  url         String?
  settings    Json?
  requestedAt DateTime     @default(now())
  completedAt DateTime?
  document    Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, requestedAt])
}

model RateCardPerson {
  id                 String            @id @default(cuid())
  workspaceId        String
  seedIdentifier     String?
  name               String
  area               String
  sourceRate         Decimal           @db.Decimal(12, 2)
  sourceCurrencyCode String
  billingPeriod      RateBillingPeriod @default(MONTH)
  archivedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  workspace          Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  candidates         Candidate[]

  @@unique([workspaceId, seedIdentifier])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, archivedAt])
}

enum PulseScanStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum PulseScanInputType {
  URL
  GITHUB_REPO
  FREE_TEXT
}

enum PulseCheckStatus {
  PASS
  WARN
  FAIL
  SKIPPED
}

model PulseScan {
  id                  String             @id @default(cuid())
  workspaceId         String
  workspace           Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId            String?
  client              WorkspaceClient?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectName         String
  inputType           PulseScanInputType
  inputUrl            String?
  inputGithubRepo     String?
  inputDescription    String?
  platform            String?
  status              PulseScanStatus    @default(RUNNING)
  scanVersion         String
  startedAt           DateTime           @default(now())
  completedAt         DateTime?
  healthScore         Int?
  previousHealthScore Int?
  techStack           Json?
  llmAnalysis         Json?
  discoveryData       Json?              // DiscoveryKit — discovery call intelligence
  agentData           Json?              // { codeInsights, deployInsights } from agent pipeline
  competitorUrls      Json?              // string[] — optional competitor URLs to benchmark
  competitorData      Json?              // CompetitorData — parallel scan results + AI comparison
  shareToken          String?            @unique
  isShared            Boolean            @default(false)
  errorCode           String?
  errorMessage        String?
  generatedProposalId String?
  checks              PulseScanCheck[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([clientId, createdAt])
  @@index([shareToken])
}

model PulseMonitor {
  id              String             @id @default(cuid())
  workspaceId     String
  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectName     String
  inputType       PulseScanInputType
  inputUrl        String?
  inputGithubRepo String?
  clientId        String?
  webhookSecret   String             @unique @default(cuid())
  lastScanId      String?
  lastHealthScore Int?
  alertThreshold  Int                @default(10)  // score drop that triggers alert
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([workspaceId])
  @@index([webhookSecret])
  @@index([inputGithubRepo])
  @@index([inputUrl])
}

model PulseScanCheck {
  id        String           @id @default(cuid())
  scanId    String
  scan      PulseScan        @relation(fields: [scanId], references: [id], onDelete: Cascade)
  category  String
  checkKey  String
  label     String
  status    PulseCheckStatus
  detail    String?
  evidence  String?
  sortOrder Int
  createdAt DateTime         @default(now())

  @@index([scanId, category])
  @@index([scanId, sortOrder])
}

// ─── Support Ops ──────────────────────────────────────────────────────────────

enum SupportClientStatus {
  ACTIVE
  INACTIVE
}

enum SupportSource {
  GMAIL
  REDDIT
  INSTAGRAM
  YOUTUBE
  DISCORD
  CLICKUP
  STRIPE
}

enum ConnectionHealth {
  CONNECTED
  NEEDS_SETUP
  ERROR
}

enum ConnectionAuthMode {
  OAUTH
  BOT_TOKEN
  MANUAL
  API_KEY
}

enum ConversationSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  DEV_REVIEW
  AWAITING_CUSTOMER
  RESOLVED
}

enum SupportTicketPriority {
  URGENT
  HIGH
  NORMAL
  LOW
}

enum DraftActionType {
  REPLY
  STRIPE_CANCEL
  STRIPE_REFUND
}

enum DraftActionStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
}

enum DraftActionRisk {
  LOW
  MEDIUM
  HIGH
}

enum SupportUserRole {
  OWNER
  STAFF
}

model SupportClient {
  id                  String                    @id @default(cuid())
  workspaceId         String
  workspace           Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                String
  slug                String
  status              SupportClientStatus       @default(ACTIVE)
  supportDaysPerMonth Int?
  supportDaysUsed     Int?                      @default(0)
  reportingRecipient  String?
  reportDueDay        Int?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  connections         AccountConnection[]
  conversations       SupportConversation[]
  tickets             SupportTicket[]
  draftActions        DraftSupportAction[]
  workflowRules       SupportWorkflowRule[]
  auditLogs           SupportAuditLog[]
  memberships         SupportClientMembership[]
  reports             SupportReport[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model SupportClientMembership {
  id        String          @id @default(cuid())
  clientId  String
  client    SupportClient   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String
  role      SupportUserRole @default(STAFF)
  createdAt DateTime        @default(now())

  @@unique([clientId, userId])
  @@index([clientId])
}

model AccountConnection {
  id            String             @id @default(cuid())
  clientId      String
  client        SupportClient      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  source        SupportSource
  label         String
  authMode      ConnectionAuthMode
  health        ConnectionHealth   @default(NEEDS_SETUP)
  secretRef     String?
  scraperConfig Json?
  nextStep      String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  channelTokens ChannelToken[]

  @@index([clientId, source])
}

model ChannelToken {
  id           String            @id @default(cuid())
  connectionId String
  connection   AccountConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  tokenData    Json
  expiresAt    DateTime?
  lastUsedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([connectionId])
}

model CustomerIdentity {
  id              String   @id @default(cuid())
  clientId        String
  externalIdHash  String
  displayLabel    String
  createdAt       DateTime @default(now())

  @@unique([clientId, externalIdHash])
  @@index([clientId])
}

model SupportConversation {
  id            String                @id @default(cuid())
  clientId      String
  client        SupportClient         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  source        SupportSource
  customerLabel String
  externalId    String?
  subject       String
  preview       String?
  unread        Boolean               @default(true)
  tags          String[]              @default([])
  sentiment     ConversationSentiment @default(NEUTRAL)
  receivedAt    DateTime
  createdAt     DateTime              @default(now())
  messages      SupportMessage[]
  tickets       SupportTicket[]

  @@index([clientId, receivedAt])
  @@index([clientId, unread])
}

model SupportMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String
  authorLabel    String
  body           String
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
}

model SupportTicket {
  id             String                @id @default(cuid())
  clientId       String
  client         SupportClient         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   SupportConversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  title          String
  customerLabel  String
  status         SupportTicketStatus   @default(OPEN)
  priority       SupportTicketPriority @default(NORMAL)
  source         SupportSource
  nextAction     String?
  issueType      String?
  assignedTo     String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  draftActions   DraftSupportAction[]

  @@index([clientId, status])
  @@index([clientId, updatedAt])
}

model DraftSupportAction {
  id         String            @id @default(cuid())
  clientId   String
  client     SupportClient     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ticketId   String?
  ticket     SupportTicket?    @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  type       DraftActionType
  title      String
  body       String
  status     DraftActionStatus @default(PENDING_APPROVAL)
  risk       DraftActionRisk   @default(LOW)
  approvedBy String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([clientId, status])
  @@index([ticketId])
}

model SupportWorkflowRule {
  id               String        @id @default(cuid())
  clientId         String
  client           SupportClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name             String
  triggerText      String
  actionsText      String
  requiresApproval Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([clientId])
}

model SupportReport {
  id        String        @id @default(cuid())
  clientId  String
  client    SupportClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  period    String
  payload   Json?
  createdBy String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([clientId, period])
}

model SupportAuditLog {
  id        String        @id @default(cuid())
  clientId  String
  client    SupportClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actorId   String?
  action    String
  target    String?
  metadata  Json?
  createdAt DateTime      @default(now())

  @@index([clientId, createdAt])
}

// ─── Study / Research ────────────────────────────────────────────────────────

enum StudyStatus {
  DRAFT
  PLAN_GENERATING
  PLAN_READY
  RUNNING
  COMPLETED
  FAILED
}

enum StudySessionMode {
  ONE_ON_ONE
  GROUP
}

enum StudyPlanStatus {
  DRAFT
  GENERATING
  READY
  LOCKED
}

enum StudyTurnType {
  SINGLE
  SEQUENCED_FLOW
}

enum StudySessionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model Study {
  id                 String           @id @default(cuid())
  workspaceId        String
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title              String
  problemStatement   String
  researchGoals      String[]         @default([])
  status             StudyStatus      @default(DRAFT)
  sessionMode        StudySessionMode @default(ONE_ON_ONE)
  selectedPersonaIds String[]         @default([])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  plan               StudyResearchPlan?
  sessions           StudySession[]
  report             StudyReport?

  @@index([workspaceId, createdAt])
}

model StudyResearchPlan {
  id        String            @id @default(cuid())
  studyId   String            @unique
  study     Study             @relation(fields: [studyId], references: [id], onDelete: Cascade)
  notes     String?
  status    StudyPlanStatus   @default(DRAFT)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  questions StudyPlanQuestion[]
}

model StudyPlanQuestion {
  id         String            @id @default(cuid())
  planId     String
  plan       StudyResearchPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  text       String
  personaIds String[]          @default([])
  turnType   StudyTurnType     @default(SINGLE)
  orderIndex Int
  rationale  String?
  createdAt  DateTime          @default(now())

  @@index([planId, orderIndex])
}

model StudySession {
  id             String             @id @default(cuid())
  studyId        String
  study          Study              @relation(fields: [studyId], references: [id], onDelete: Cascade)
  personaId      String
  personaName    String
  mode           StudySessionMode   @default(ONE_ON_ONE)
  status         StudySessionStatus @default(PENDING)
  transcriptData Json?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([studyId, status])
}

model StudyReport {
  id        String   @id @default(cuid())
  studyId   String   @unique
  study     Study    @relation(fields: [studyId], references: [id], onDelete: Cascade)
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
