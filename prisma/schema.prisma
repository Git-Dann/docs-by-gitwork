model SupportAuditLog {
  id        String        @id @default(cuid())
  clientId  String
  client    SupportClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actorId   String?
  action    String
  target    String?
  metadata  Json?
  createdAt DateTime      @default(now())

  @@index([clientId, createdAt])
}

// ─── Study / Research ────────────────────────────────────────────────────────

enum StudyStatus {
