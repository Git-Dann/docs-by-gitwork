enum PulseScanStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum PulseScanInputType {
  URL
  GITHUB_REPO
  FREE_TEXT
}

enum PulseCheckStatus {
  PASS
  WARN
  FAIL
  SKIPPED
}

model PulseScan {
  id                  String             @id @default(cuid())
  workspaceId         String
  workspace           Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId            String?
  client              WorkspaceClient?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  triggeredByUserId   String? // null = monitor/webhook-triggered. Used by push to attribute scans to the user who started them.
  triggeredByUser     User?              @relation("PulseScanTriggeredBy", fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  projectName         String
  inputType           PulseScanInputType
  inputUrl            String?
  inputGithubRepo     String?
  inputDescription    String?
  platform            String?
  status              PulseScanStatus    @default(RUNNING)
  scanVersion         String
  startedAt           DateTime           @default(now())
  completedAt         DateTime?
  // Set when the deterministic checks finish and have been persisted, while AI
  // synthesis is still running (status stays RUNNING). Lets the UI show the full
  // checks view + a "checks done, AI running" state instead of gating on the LLM.
  checksCompletedAt   DateTime?
  healthScore         Int?
  previousHealthScore Int?
  techStack           Json?
  llmAnalysis         Json?
  discoveryData       Json? // DiscoveryKit — discovery call intelligence
  agentData           Json? // { codeInsights, deployInsights } from agent pipeline
  competitorUrls      Json? // string[] — optional competitor URLs to benchmark
  competitorData      Json? // CompetitorData — parallel scan results + AI comparison
  targetMarkets       Json? // JurisdictionCode[] — user-declared markets the product serves (null = legacy/auto-only)
  detectedMarkets     Json? // JurisdictionCode[] — auto-detected at scan time (audit + legacy fallback)
  complianceScorecard Json? // JurisdictionScorecardEntry[] — deterministic per-market required/missing breakdown
  scoreBreakdown      Json? // ScoreBreakdown — "why this score" (per-category contribution + hard caps)
  pricingBands        Json? // PricingBand[] — deterministic dev-tier pricing/timeline (1/2/3 devs)
  shareToken          String?            @unique
  isShared            Boolean            @default(false)
  errorCode           String?
  errorMessage        String?
  generatedProposalId String?
  // Optional link to a Study launched to validate this scan's assumptions (Study is now
  // an optional tool under Pulse). Loose nullable id, not an FK — matches the cross-module
  // convention here; kept in sync with Study.linkedScanId on study creation.
  linkedStudyId       String?
  // Optional link to a Starter (Prompt→Production building block) a user adopted from this
  // scan. Loose nullable id, not an FK — one side only (a Starter is a reusable catalog item,
  // so it is not back-linked to a single scan). Flips the scan-results "Starters" slot to
  // "View starter". See src/server/starters.ts adoptStarterForScan().
  linkedStarterId     String?
  checks              PulseScanCheck[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([clientId, createdAt])
  @@index([shareToken])
}

model PulseMonitor {
  id               String             @id @default(cuid())
  workspaceId      String
  workspace        Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectName      String
  inputType        PulseScanInputType
  inputUrl         String?
  inputGithubRepo  String?
  clientId         String?
  webhookSecret    String             @unique @default(cuid())
  lastScanId       String?
  lastHealthScore  Int?
  alertThreshold   Int                @default(10) // score drop that triggers alert
  isActive         Boolean            @default(true)
  // Continuous monitoring (additive): scheduled re-scans + new-critical alerting.
  frequency        String             @default("DAILY") // "DAILY" | "WEEKLY" | "OFF"
  lastRunAt        DateTime? // last scheduled run (cron stamps this)
  lastCriticalKeys Json? // string[] — CONFIRMED-critical checkKeys at last run, to diff for "new issue appeared"
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([workspaceId])
  @@index([webhookSecret])
  @@index([inputGithubRepo])
  @@index([inputUrl])
}

model PulseScanCheck {
  id               String           @id @default(cuid())
  scanId           String
  scan             PulseScan        @relation(fields: [scanId], references: [id], onDelete: Cascade)
  category         String
  checkKey         String
  label            String
  status           PulseCheckStatus
  detail           String?
  evidence         String?
  sortOrder        Int
  createdAt        DateTime         @default(now())
  // Trust layer (additive): how sure we are the check is true + which bucket.
  confidence       String? // "HIGH" | "MEDIUM" | "LOW"
  confidenceReason String?
  trustBucket      String? // "CONFIRMED" | "LIKELY" | "VERIFIED_WORKING" | "INCONCLUSIVE"

  @@index([scanId, category])
  @@index([scanId, sortOrder])
}

// ─── Pulse Lite (public embeddable scanner) ───────────────────────────────────
// Anonymous, AI-free scans run from the public /embed/pulse widget. Kept in their
// OWN tables so anonymous traffic never pollutes workspace PulseScan stats/lists.
// Checks are stored inline as JSON (ephemeral; rows TTL-expire via expiresAt).

model PulseLiteScan {
  id             String          @id @default(cuid())
  targetUrl      String
  targetHost     String
  ip             String?
  status         PulseScanStatus @default(RUNNING)
  healthScore    Int?
  techStack      Json? // string[]
  checks         Json? // PulseScanCheckInput[] — persisted incrementally as waves land
  insights       Json? // BrowserAgentInsights | null
  emailCaptured  Boolean         @default(false)
  leadId         String? // → PulseLead once an email is captured
  importedScanId String? // → workspace PulseScan once "Import to Foundry" is used
  errorMessage   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  expiresAt      DateTime? // raw scan rows are pruned after this (privacy + table hygiene)

  @@index([ip, createdAt])
  @@index([targetHost, createdAt])
  @@index([expiresAt])
}

model PulseLead {
  id                String    @id @default(cuid())
  email             String
  liteScanId        String?
  targetUrl         String
  healthScore       Int?
  source            String    @default("embed")
  convertedClientId String? // → WorkspaceClient if the lead is imported into Foundry
  notifiedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([email])
  @@index([createdAt])
}

// ─── Support Ops ──────────────────────────────────────────────────────────────

enum SupportClientStatus {
  ACTIVE
  INACTIVE
}

enum SupportSource {
  GMAIL
  REDDIT
  INSTAGRAM
  YOUTUBE
  DISCORD
  CLICKUP
  STRIPE
  ANALYTICS
  APP_REVIEWS
  WEBHOOK
}

enum ConnectionHealth {
  CONNECTED
  NEEDS_SETUP
  ERROR
}

enum ConnectionAuthMode {
  OAUTH
  BOT_TOKEN
  MANUAL
  API_KEY
}

enum ConversationSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

// Triage state machine for the shared-inbox cockpit. NEW = untouched by a human;
// first transition out of NEW stamps firstTriagedAt. CLOSED/IGNORED stamp closedAt.
enum ConversationStatus {
  NEW
  OPEN
  SNOOZED
  CLOSED
  IGNORED
}

enum ConversationPriority {
  URGENT
  HIGH
  NORMAL
  LOW
}

// NOTE: SupportTicketStatus/SupportTicketPriority/DraftAction* enums below are
// retained for the now-dormant SupportTicket/DraftSupportAction tables. The Care
// cockpit no longer writes them, but they MUST stay (dropping an enum value would
// make `prisma db push` skip the whole sync — see CLAUDE.md PR #189).
enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  DEV_REVIEW
  AWAITING_CUSTOMER
  RESOLVED
}

enum SupportTicketPriority {
  URGENT
  HIGH
  NORMAL
  LOW
}

enum DraftActionType {
  REPLY
  STRIPE_CANCEL
  STRIPE_REFUND
}

enum DraftActionStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
}

enum DraftActionRisk {
  LOW
  MEDIUM
  HIGH
}

enum SupportUserRole {
  OWNER
  STAFF
}

model SupportClient {
  id                  String                     @id @default(cuid())
  workspaceId         String
  workspace           Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                String
  slug                String
  status              SupportClientStatus        @default(ACTIVE)
  supportDaysPerMonth Int?
  supportDaysUsed     Int?                       @default(0)
  reportingRecipient  String?
  reportDueDay        Int?
  workspaceClientId   String?
  workspaceClient     WorkspaceClient?           @relation(fields: [workspaceClientId], references: [id], onDelete: SetNull)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  connections         AccountConnection[]
  conversations       SupportConversation[]
  tickets             SupportTicket[]
  draftActions        DraftSupportAction[]
  workflowRules       SupportWorkflowRule[]
  auditLogs           SupportAuditLog[]
  memberships         SupportClientMembership[]
  reports             SupportReport[]
  analyticsSnapshots  SupportAnalyticsSnapshot[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model SupportClientMembership {
  id        String          @id @default(cuid())
  clientId  String
  client    SupportClient   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String
  role      SupportUserRole @default(STAFF)
  createdAt DateTime        @default(now())

  @@unique([clientId, userId])
  @@index([clientId])
}

model AccountConnection {
  id            String             @id @default(cuid())
  clientId      String
  client        SupportClient      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  source        SupportSource
  label         String
  authMode      ConnectionAuthMode
  health        ConnectionHealth   @default(NEEDS_SETUP)
  secretRef     String?
  scraperConfig Json?
  nextStep      String?
  lastSyncedAt  DateTime?
  lastSyncStats Json?
  syncCursor    String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  channelTokens ChannelToken[]

  @@index([clientId, source])
}

model ChannelToken {
  id           String            @id @default(cuid())
  connectionId String
  connection   AccountConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  tokenData    Json
  expiresAt    DateTime?
  lastUsedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([connectionId])
}

model CustomerIdentity {
  id             String   @id @default(cuid())
  clientId       String
  externalIdHash String
  displayLabel   String
  createdAt      DateTime @default(now())

  @@unique([clientId, externalIdHash])
  @@index([clientId])
}

model SupportConversation {
  id              String                    @id @default(cuid())
  clientId        String
  client          SupportClient             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  source          SupportSource
  customerLabel   String
  externalId      String?
  subject         String
  preview         String?
  unread          Boolean                   @default(true)
  tags            String[]                  @default([])
  sentiment       ConversationSentiment     @default(NEUTRAL)
  receivedAt      DateTime
  createdAt       DateTime                  @default(now())
  // ── triage state machine (the conversation is the unit of triage) ──
  status          ConversationStatus        @default(NEW)
  priority        ConversationPriority      @default(NORMAL)
  issueType       String?
  assigneeId      String? // workspace User id
  snoozeUntil     DateTime?
  firstTriagedAt  DateTime? // first transition out of NEW (replaces ticket.firstReplyAt for metrics)
  closedAt        DateTime? // set on CLOSED/IGNORED (replaces ticket.resolvedAt)
  // ── deep-link out to the native channel ──
  externalUrl     String? // canonical native-thread URL ("Open in {channel}")
  externalGuildId String? // Discord guild id, used to build the channel deep-link
  messages        SupportMessage[]
  tickets         SupportTicket[]
  notes           SupportConversationNote[]

  @@index([clientId, receivedAt])
  @@index([clientId, unread])
  @@index([clientId, status])
  @@index([clientId, assigneeId])
  @@index([clientId, snoozeUntil])
}

// Internal staff-only notes on a conversation. Kept separate from SupportMessage so
// the customer thread fed to the triage agent stays pristine (no internal text leaks
// into classification, no direction/dedup confusion).
model SupportConversationNote {
  id             String              @id @default(cuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String? // workspace User id; null = agent-authored
  body           String
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
}

model SupportMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String
  authorLabel    String
  body           String
  externalId     String?
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
  @@index([conversationId, externalId])
}

model SupportTicket {
  id             String                @id @default(cuid())
  clientId       String
  client         SupportClient         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   SupportConversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  title          String
  customerLabel  String
  status         SupportTicketStatus   @default(OPEN)
  priority       SupportTicketPriority @default(NORMAL)
  source         SupportSource
  nextAction     String?
  issueType      String?
  assignedTo     String?
  resolvedAt     DateTime?
  firstReplyAt   DateTime?
  csatScore      Int?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  draftActions   DraftSupportAction[]

  @@index([clientId, status])
  @@index([clientId, updatedAt])
}

model DraftSupportAction {
  id         String            @id @default(cuid())
  clientId   String
  client     SupportClient     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ticketId   String?
  ticket     SupportTicket?    @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  type       DraftActionType
  title      String
  body       String
  status     DraftActionStatus @default(PENDING_APPROVAL)
  risk       DraftActionRisk   @default(LOW)
  approvedBy String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([clientId, status])
  @@index([ticketId])
}

model SupportWorkflowRule {
  id               String        @id @default(cuid())
  clientId         String
  client           SupportClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name             String
  triggerText      String
  actionsText      String
  requiresApproval Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([clientId])
}

model SupportReport {
  id        String        @id @default(cuid())
  clientId  String
  client    SupportClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  period    String
  payload   Json?
  createdBy String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([clientId, period])
}

// Monthly capture of a client's analytics metrics, so trends use real historical
// data (not a fragile live current-vs-previous fetch). Written by the snapshot cron.
model SupportAnalyticsSnapshot {
  id         String        @id @default(cuid())
  clientId   String
  client     SupportClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  period     String // "YYYY-MM"
  metrics    Json // AnalyticsMetric[]
  capturedAt DateTime      @default(now())

  @@unique([clientId, period])
  @@index([clientId, period])
