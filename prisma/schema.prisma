// ─── Starters (Prompt→Production library) ───────────────────────────────────
// A Gitwork-branded catalog of reusable building blocks (prompts, skills, plugins, kits,
// collections), surfaced as an admin-only tool inside Pulse. Mirrors the DocumentTemplate /
// OnboardingForm catalog shape: nullable workspaceId (global built-in vs workspace-authored),
// unique slug, Json payload, isDefault, status enum. Every catalog entry is presented under
// the Gitwork name only — provenance lives in content._buildRef and is never serialized to any
// UI surface (see serializeStarter in src/server/starters.ts).

enum StarterType {
  PROMPT
  SKILL
  PLUGIN
  KIT
  COLLECTION
}

enum StarterStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Starter {
  id          String        @id @default(cuid())
  workspaceId String? // nullable → global built-in vs workspace-authored
  workspace   Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  name        String
  slug        String        @unique
  summary     String // one-line card subtitle
  description String? // longer body (markdown)
  type        StarterType   @default(KIT)
  status      StarterStatus @default(PUBLISHED)
  tags        String[]      @default([])
  content     Json? // "what you get" bullets, install steps, prompt text, tech stack, + internal _buildRef
  featured    Boolean       @default(false) // pinned to the top of the library with a star
  isDefault   Boolean       @default(false) // shipped Gitwork built-in library entry
  isArchived  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([workspaceId, createdAt])
}

// ─── Handbook (internal developer knowledgebase) ────────────────────────────
// A global, workspace-level, searchable library of developer standards, playbooks and
// process — the canonical "how Gitwork builds". Super-Admin-only for now (role-gated like
// Starters, not a grantable feature perm). Articles are free-form markdown, grouped by a
// lightweight string `category` (the rail derives its list from the articles that exist).

enum HandbookStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model HandbookArticle {
  id          String         @id @default(cuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  authorId    String? // last editor / author; SetNull so deleting a user keeps the article
  author      User?          @relation("HandbookAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  title       String
  slug        String         @unique
  summary     String         @default("") // one-line card subtitle + reading-surface lede
  category    String         @default("General") // freeform; the rail lists categories in use
  content     String         @default("") // markdown body
  tags        String[]       @default([]) // visible tags shown on the article
  keywords    String[]       @default([]) // hidden search tags — related terms / synonyms for smart search
  status      HandbookStatus @default(PUBLISHED)
  featured    Boolean        @default(false) // pinned to the top of the library with a star
  readMinutes Int? // estimated read time (computed on save)
  orderKey    Int            @default(0)
  viewCount   Int            @default(0)
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([workspaceId, category])
  @@index([workspaceId, updatedAt])
}

// ─── Agent & Check Configuration ────────────────────────────────────────────

model AgentConfig {
  id                   String    @id @default(cuid())
  workspaceId          String
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentKey             String // e.g. "pulse:synthesis", "study:researcher"
  product              String // "pulse" | "study"
  enabled              Boolean   @default(true)
  systemPromptOverride String?   @db.Text
  modelOverride        String?
  configJson           Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([workspaceId, agentKey])
  @@index([workspaceId])
}

model PulseCheckConfig {
  id               String    @id @default(cuid())
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  checkKey         String // matches hardcoded checkKey, or cuid() for custom checks
  enabled          Boolean   @default(true)
  labelOverride    String?
  severityOverride String? // "WARN" | "FAIL" — downgrade/upgrade threshold
  isCustom         Boolean   @default(false)
  customConfig     Json? // for custom checks: { type, pattern, url, expected, ... }
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([workspaceId, checkKey])
  @@index([workspaceId])
}

// Per-user notification preferences. One row per user.
// `events` shape: { [eventKey: string]: ("email" | "push" | "slack" | "inApp")[] }
// `digestCadence`: OFF | DAILY | WEEKLY
model NotificationPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled    Boolean  @default(true)
  pushEnabled     Boolean  @default(true)
  slackEnabled    Boolean  @default(false)
  inAppEnabled    Boolean  @default(true)
  events          Json     @default("{}")
  digestCadence   String   @default("OFF")
  quietHoursStart String? // "22:00" — 24h HH:mm, workspace timezone
  quietHoursEnd   String? // "07:00"
  timezone        String? // IANA tz, e.g. "Europe/London"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Persisted in-app notification feed. One row per (recipient, grouped event) — grouping
// collapses many same-kind events for one user into a single row whose `count` increments
// (see dispatchNotification in src/server/notifications.ts). `workspaceId`/`clientId` are
// plain string columns (no FK relation) so a row survives a client being archived or a dev
// losing their ClientAssignment — scope is re-checked on read instead of cascading/nulling.
model Notification {
  id          String    @id @default(cuid())
  workspaceId String // forward-compat; single workspace today
  userId      String // RECIPIENT (never the actor)
  event       String // a NOTIFICATION_EVENTS id, e.g. "tasks.assigned"
  title       String // "You were assigned 15 tasks"
  body        String?   @db.Text
  groupKey    String // collapse key incl. recipient, e.g. "tasks.assigned:<userId>"
  count       Int       @default(1) // grouped item count → drives "15 tasks"
  read        Boolean   @default(false)
  readAt      DateTime?
  actionUrl   String? // deep link
  clientId    String? // soft ref; re-checked against client scope on read
  metadata    Json? // { actorId?, taskIds?, entityId? }
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt(sort: Desc)]) // badge count + unread-first feed
  @@index([userId, updatedAt(sort: Desc)]) // feed ordered by group-bump
  @@index([userId, groupKey, read]) // grouping upsert lookup
  @@index([workspaceId])
}

// Workspace-scoped audit trail. Recorded by `recordAuditEntry()` for critical actions
// (settings changes, key rotations, role changes, integration connect/disconnect).
model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action      String // e.g. "settings.ai_provider.changed", "team.member.invited"
  target      String? // resource identifier (e.g. "workspace:aiProvider", "user:abc123")
  before      Json? // previous value (omit for create events)
  after       Json? // new value (omit for delete events)
  metadata    Json? // free-form context (ip, userAgent, source)
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@index([action])
  @@index([actorId])
}

// Generic workspace-shared cache for AI responses. Anywhere a Foundry feature calls an
// AI provider and the output is identical regardless of who's asking, route it through
// `getCachedAiResponse()` in `src/server/ai-cache.ts`. Saves repeat API spend whenever
// the same Gitwork teammate (or different ones) trigger the same AI work.
//
// `cacheKey` is the namespace + resource id (e.g. "slack-activity:C0123ABCDEF",
// "proof-analyse:<sha256>"). `inputsHash` invalidates when the actual inputs to the AI
// call change — so cached entries auto-refresh when the underlying data shifts.
model AiResponseCache {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cacheKey    String
  inputsHash  String
  response    Json
  modelUsed   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, cacheKey])
  @@index([workspaceId, updatedAt])
}

// Workspace-shared cache for AI-generated meeting summaries.
// Keyed by (workspaceId, eventId) — Google Calendar event IDs are stable across all
// attendees, so anyone on the same call gets the same cached summary instead of paying
// for another AI call. Cached entries also store `inputsHash` so we know to invalidate
// when meeting details change (new attendee added, different channels selected, etc.).
model MeetingSummary {
  id                String    @id @default(cuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  eventId           String
  summary           String    @db.Text
  inputsHash        String
  modelUsed         String?
  generatedByUserId String?
  generatedBy       User?     @relation("MeetingSummaryGenerator", fields: [generatedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([workspaceId, eventId])
  @@index([workspaceId, updatedAt])
}

// ── Scribe (client-scoped AI notetaker) ─────────────────────────────────
// Scribe turns Google Meet's native transcripts into client-scoped meeting
// records: transcript + AI summary + decisions + action items. Surfaced
// quietly on the client detail page in Portal. Capture is offloaded to
// Google Meet (no long-running compute here) — see src/server/google-meet.ts.
enum MeetingNoteStatus {
  AWAITING_TRANSCRIPT // calendar event known, transcript not yet fetched
  TRANSCRIBED // transcript pulled, summary pending
  SUMMARISED // summary + decisions + action items ready
  NO_TRANSCRIPT // meeting had no transcript available
  ERROR // ingest/summarise failed
}

model Meeting {
  id                   String              @id @default(cuid())
  workspaceId          String
  workspace            Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Attributed client. Scribe is client-scoped; unattributed meetings are not shown in Portal.
  clientId             String?
  client               WorkspaceClient?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  // Google Calendar event id + Meet meeting code (from hangoutLink, e.g. "abc-defg-hij").
  calendarEventId      String?
  meetingCode          String?
  // Meet API resource name "conferenceRecords/{id}" — the natural idempotency key per session.
  conferenceRecordName String?
  title                String
  startedAt            DateTime?
  endedAt              DateTime?
  attendees            String[]            @default([]) // attendee emails
  status               MeetingNoteStatus   @default(AWAITING_TRANSCRIPT)
  transcriptText       String?             @db.Text // flattened "Speaker: text" transcript
  transcriptData       Json? // structured entries [{ speaker, text, startTime }]
  summary              String?             @db.Text
  decisions            Json? // string[]
  modelUsed            String?
  // Whose Google account surfaced the transcript (per-user OAuth).
  ownerUserId          String?
  owner                User?               @relation("MeetingOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  actionItems          MeetingActionItem[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  // Idempotency: manual + cron ingest upsert by calendar event; conference record is the
  // secondary natural key once a session is matched. Both columns are nullable (Postgres
  // permits multiple NULLs), so rows without one don't collide.
  @@unique([workspaceId, calendarEventId])
  @@unique([workspaceId, conferenceRecordName])
  @@index([clientId, startedAt])
  @@index([workspaceId, status])
}

model MeetingActionItem {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title     String? // short imperative title (AI); `text` holds the fuller detail/description
  text      String
  owner     String? // free-text owner name/email pulled from the transcript
  done      Boolean  @default(false)
  taskId    String? // the board Task created from this item (set on "Add task", cleared on remove)
  createdAt DateTime @default(now())

  @@index([meetingId])
}

// ── Backstage (internal ops): leave + expenses ──────────────────────────
// Backstage is the umbrella for internal Gitwork ops tools. v1 covers staff
// leave booking + expenses tracking, surfaced as proactive staffing alerts
// on the Foundry HQ dashboard. Future sub-tools (finance, inventory, vendor
// admin) slot in under the same module without re-shaping the schema.
model LeaveRequest {
  id            String    @id @default(cuid())
  workspaceId   String
  userId        String
  type          String // ANNUAL | SICK | UNPAID | OTHER
  startDate     DateTime // day-precision, UTC midnight
  endDate       DateTime // inclusive
  halfDayStart  Boolean   @default(false)
  halfDayEnd    Boolean   @default(false)
  reason        String?
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  approvedById  String?
  approvedAt    DateTime?
  rejectionNote String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user       User      @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User?     @relation("LeaveApprover", fields: [approvedById], references: [id])

  @@index([workspaceId, userId])
  @@index([workspaceId, status])
  @@index([startDate, endDate])
}

model Expense {
  id           String    @id @default(cuid())
  workspaceId  String
  userId       String
  amount       Decimal   @db.Decimal(10, 2)
  currency     String    @default("GBP")
  category     String // TRAVEL | EQUIPMENT | SOFTWARE | MEALS | ACCOMMODATION | OTHER
  vendor       String?
  occurredOn   DateTime // day-precision
  notes        String?
  // Receipt image lifecycle: full image lives in `receiptImage` while the expense
  // is unresolved. On review the bytes drop and a small thumb is generated for
  // audit. Object-storage migration logged in CLAUDE.md when volume grows.
  receiptImage Bytes?
  receiptThumb Bytes?
  receiptMime  String? // "image/jpeg" | "image/webp" | "image/png"
  status       String    @default("SUBMITTED") // SUBMITTED | APPROVED | REJECTED | REIMBURSED
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user       User      @relation("ExpenseClaimant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?     @relation("ExpenseReviewer", fields: [reviewedById], references: [id])

  @@index([workspaceId, userId])
  @@index([workspaceId, status])
  @@index([occurredOn])
}

// ── Tasks (Portal task tracker + daily Slack standups) ─────────────────────

/// Status workflow for the Portal task board. Columns render in this order.
enum TaskStatus {
  BACKLOG
  TODO
  DOING
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

/// Links a team member to a specific client. Backs the `seeAllClients=off`
/// feature flag: a developer with this flag off only sees clients they're
/// assigned to here (Portal, task board, standups). Admins / `seeAllClients`
/// holders bypass and see every workspace client.
model ClientAssignment {
  id          String          @id @default(cuid())
  workspaceId String
  clientId    String
  userId      String
  createdAt   DateTime        @default(now())
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client      WorkspaceClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@index([userId])
  @@index([workspaceId])
}

model Task {
  id                 String       @id @default(cuid())
  workspaceId        String
  clientId           String
  assigneeId         String?
  createdById        String?
  /// Optional "list" / feature block this task belongs to. Loose tasks (null)
  /// show on the board but not the Gantt.
  featureBlockId     String?
  /// Parent task for subtasks (one level deep). Null = top-level task.
  parentId           String?
  title              String
  description        String?      @db.Text
  /// Optional acceptance criteria (freeform / markdown).
  acceptanceCriteria String?      @db.Text
  status             TaskStatus   @default(BACKLOG)
  priority           TaskPriority @default(MEDIUM)
  /// Fractional sort key for drag-ordering within a status column. New cards
  /// get (max+1); a card dropped between two others gets the midpoint.
  orderKey           Float        @default(0)
  dueDate            DateTime?
  /// Stamped the first time the task enters DOING; drives "started" displays.
  startedAt          DateTime?
  /// Stamped when the task enters DONE (cleared if moved back out). Drives the
  /// standup "Done today" section — a task counts as done-today when
  /// completedAt falls on the dev's workDate.
  completedAt        DateTime?
  /// Imported ClickUp custom fields (Dept, Build Number, QA, Category…). Display-only.
  metadata           Json?
  /// Source ClickUp task id (one-time migration). Indexed, NOT unique.
  clickupId          String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  /// Soft-archive: hidden from board/list/Gantt + dashboard scans, but never deleted (the
  /// Archived tab reads these). Set manually or by the daily auto-archive cron (DONE > 30d).
  archivedAt         DateTime?

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client           WorkspaceClient   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Legacy single assignee — kept (not dropped) so prisma db push stays additive;
  // the app reads `assignees`, falling back to this when the join is empty.
  assignee         User?             @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assignees        User[]            @relation("TaskAssignees")
  createdBy        User?             @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  featureBlock     FeatureBlock?     @relation(fields: [featureBlockId], references: [id], onDelete: SetNull)
  parent           Task?             @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks         Task[]            @relation("Subtasks")
  comments         TaskComment[]
  slackMessageRefs SlackMessageRef[]

  @@index([workspaceId, clientId, status])
  @@index([assigneeId, status])
  @@index([clientId, status, orderKey])
  @@index([featureBlockId])
  @@index([parentId])
  @@index([clickupId])
  // Cross-client dashboard reads: the existing [workspaceId, clientId, status]
  // can't serve a workspace-wide status/due query (clientId sits between the two
  // predicates). These match getTaskAttention's overdue/due-soon/doing scans and
  // the HQ status rollups directly — important now that the board holds 1k+ tasks.
  @@index([workspaceId, status])
  @@index([workspaceId, dueDate])
  // Default board/list/Gantt reads filter archivedAt IS NULL; the cron scans archivedAt + status.
  @@index([workspaceId, archivedAt])
}

/// Message↔task linkage for Slack interactivity. Persisted when Foundry posts a
/// rich Block Kit card so an incoming button-click payload (which carries the
/// message channel + ts + a SlackMessageRef id) can be authoritatively resolved
/// back to a Task without trusting client-supplied IDs.
///
/// `kind` is a free-form string ("STANDUP_AM" | "STANDUP_PM" | "ROLLUP" | …)
/// rather than an enum so new card types can ship without a schema change.
model SlackMessageRef {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channelId   String
  /// Slack message timestamp ("1718000000.000100") — identifies the message
  /// inside its channel. Paired with channelId in the unique index.
  messageTs   String
  taskId      String?
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  kind        String
  postedById  String?
  createdAt   DateTime  @default(now())

  @@unique([channelId, messageTs])
  @@index([workspaceId, taskId])
  @@index([workspaceId, kind, createdAt])
}

/// Append-only log of ad-hoc Slack pushes from the Tasks page — on-demand project
/// updates and the DevOps lead's cross-client broadcasts. Gives a lightweight
/// history (and "who posted today" presence for a lead who has no tasks). One row
/// per posted client; a broadcast also writes a summary row (clientId null).
model SlackUpdateLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  /// Free-form: "PROJECT_UPDATE" | "BROADCAST". String (not enum) to mirror SlackMessageRef.kind.
  kind        String
  clientId    String? // posted client; null only for a broadcast-summary row
  channelId   String?
  taskCount   Int?
  message     String?  @db.Text
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
}

/// Free-text notes on a task. A simple append-only thread (mirrors how Care
/// keeps SupportMessage rows). Author is nullable so notes survive member removal.
model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String?
  body      String   @db.Text
  /// User ids @mentioned in this note (resolved at write time). Drives the tag
  /// notification + highlighted rendering. Additive/nullable — legacy rows stay null.
  mentions  Json?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

/// One row per (dev, work day). A thin push-log: the Doing/Done content of the
/// Slack standup is derived from live Task state at push time, this just records
/// WHEN each phase was pushed plus the editable Monday "This week" plan + an
/// optional free note. DevOps reads pmPushedAt across devs to gate the roll-up.
model DailyUpdate {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  /// UTC midnight of the work day this update covers.
  workDate    DateTime
  amPushedAt  DateTime?
  pmPushedAt  DateTime?
  /// Monday "This week" section — prefilled from tasks due this ISO week, edited by the dev.
  weekPlan    String?   @db.Text
  note        String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, workDate])
  @@index([workspaceId, workDate])
}

/// A "list" / feature block — the unit of timeline planning. Carries the
/// start/end dates that render as a single bar on the client Gantt. Tasks
/// optionally belong to a block; loose tasks show on the board, not the Gantt.
model FeatureBlock {
  id          String          @id @default(cuid())
  workspaceId String
  clientId    String
  name        String
  description String?         @db.Text
  /// Optional — a block with both dates is a Gantt bar; without, it's a board-only grouping.
  startDate   DateTime?
  endDate     DateTime?
  /// Fractional sort key for ordering blocks in the list + Gantt.
  orderKey    Float           @default(0)
  /// Optional bar accent key from a small named palette (resolved client-side).
  color       String?
  /// Source ClickUp list id (one-time migration). Indexed, NOT unique.
  clickupId   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client      WorkspaceClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([workspaceId, clientId])
  @@index([clientId, startDate])
  @@index([clickupId])
}

/// A single-date timeline marker (separate from feature-block bars). Renders as
/// a diamond on the client Gantt (internal + public). Imported from ClickUp
/// "Milestones" lists.
model Milestone {
  id          String          @id @default(cuid())
  workspaceId String
  clientId    String
  name        String
  date        DateTime
  description String?         @db.Text
  color       String?
  /// Source ClickUp task id (one-time migration). Indexed, NOT unique.
  clickupId   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client      WorkspaceClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, date])
  @@index([clickupId])
}

// ── On Your Desk ─────────────────────────────────────────────────────────────

/// A short personal reminder shown in the "On Your Desk" drawer. Deliberately
/// ephemeral: surfaced only while young (the read query filters to the last 7
/// days) and hard-deleted by an opportunistic purge thereafter. Not a task — no
/// board, no status, no assignee. Per-user.
model DeskReminder {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  body        String   @db.Text
  done        Boolean  @default(false)
  // "MANUAL" = typed into the On Your Desk clipboard by the owner; "SLACK" =
  // created via the /desk slash command. The clipboard shows MANUAL only; the
  // "Needs you today" list surfaces SLACK ones. Additive, defaults MANUAL.
  source      String   @default("MANUAL")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, createdAt])
}

/// A workspace-wide announcement banner shown in "On Your Desk" to everyone.
/// Posted by admins/super-admins only. At most ONE active per workspace at a
/// time — enforced in app logic (posting a new one deactivates the current in a
/// single transaction). Auto-hidden past expiresAt (reads filter on it).
model Broadcast {
  id          String   @id @default(cuid())
  workspaceId String
  message     String   @db.Text
  active      Boolean  @default(true)
  expiresAt   DateTime
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("BroadcastCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId, active, expiresAt])
}

// ── Data lifecycle: durable job queue + retention/cold-storage ───────────────

model BackgroundJob {
  id          String              @id @default(cuid())
  workspaceId String?
  /// Handler key, e.g. "CLIENT_ARCHIVE". Maps to a handler in src/server/jobs/handlers.ts.
  type        String
  payload     Json
  status      BackgroundJobStatus @default(PENDING)
  attempts    Int                 @default(0)
  maxAttempts Int                 @default(5)
  /// Earliest time the job may run. Backoff pushes this forward on each retry.
  runAt       DateTime            @default(now())
  /// Optional collapse key. `enqueueJob` skips creating a new row when a PENDING/RUNNING job with
  /// the same key already exists (e.g. one in-flight archive per client). NOT a DB unique — a
  /// completed key can be re-enqueued later (re-archive), and a unique index would block that.
  dedupeKey   String?
  lastError   String?             @db.Text
  result      Json?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  workspace   Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([dedupeKey, status])
}

model ColdArchive {
  id              String        @id @default(cuid())
  workspaceId     String?
  /// Which RetentionPolicy produced this (e.g. "docs.view-events").
  policyKey       String
  /// The hot entity that was offloaded (e.g. "DocumentViewEvent").
  entity          String
  /// Optional scope the batch belongs to (e.g. the documentId) for targeted rehydrate.
  scopeId         String?
  /// Cold store location: store = "drive" | "fs"; ref = Drive file id or filesystem path.
  store           String
  ref             String        @db.Text
  rowCount        Int           @default(0)
  byteSize        Int?
  /// Age window of the offloaded data (min/max source timestamp in the batch).
  periodStart     DateTime?
  periodEnd       DateTime?
  tier            RetentionTier @default(COLD)
  /// When this cold copy becomes eligible for purge-review (past its final retention window).
  /// Null = keep indefinitely. Surfaced on On Your Desk for admins once <= now and not yet purged.
  purgeEligibleAt DateTime?
  /// Set when an admin approves permanent deletion of the cold copy. Never automatic.
  purgedAt        DateTime?
  createdAt       DateTime      @default(now())
  workspace       Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, policyKey])
  @@index([purgeEligibleAt, purgedAt])
  @@index([entity, scopeId])
}

enum BackgroundJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  /// Dead-lettered after exhausting maxAttempts. Inspect `lastError`; re-enqueue to retry.
  FAILED
}

enum RetentionTier {
  WARM
  COLD
  DEEP
}

// ════════════════════════════════════════════════════════════════════════════
// MCP / OAuth 2.1 (Phase 3)
//
// Foundry is the authorization server for the in-app MCP route at /api/mcp.
// Claude (or any OAuth-compatible MCP client) goes through an authorization-
// code-with-PKCE flow against /api/oauth/{authorize,token,revoke}. Tokens are
// opaque (foundry_at_<base64url> / foundry_rt_<base64url>) and stored as
// SHA-256 hashes — same revocation model as a personal access token.
//
// Scopes are coarse-by-design: a single `mcp` scope grants the MCP route,
// then the MCP route applies the user's normal FEATURE_PERMISSIONS / can*()
// checks. We can split granular scopes later without a schema change.
// ════════════════════════════════════════════════════════════════════════════

enum OAuthTokenType {
  ACCESS
  REFRESH
}

/// An OAuth client app that's allowed to authorize Foundry users. Claude
/// self-registers via /api/oauth/register (Dynamic Client Registration,
/// RFC 7591); admins can also pre-register clients from Settings.
/// We only support PUBLIC clients (PKCE, no client secret) — sufficient for
/// any modern OAuth 2.1 client.
model OAuthClient {
  /// Doubles as the public OAuth client_id. cuid() is unguessable enough.
  id           String   @id @default(cuid())
  clientName   String
  redirectUris String[]
  /// Optional logo URL the client supplied at registration (consent screen).
  logoUri      String?
  /// Optional homepage / docs URL.
  clientUri    String?
  createdAt    DateTime @default(now())

  authCodes      OAuthAuthCode[]
  tokens         OAuthToken[]
  mcpConnections McpConnection[]
}

/// Short-lived authorization code issued at the end of /api/oauth/authorize
/// and exchanged once at /api/oauth/token. PKCE verifier (RFC 7636) is
/// captured here and checked at exchange. Single-use: `usedAt` is set on
/// successful exchange and a second attempt is rejected.
model OAuthAuthCode {
  id                  String      @id @default(cuid())
  /// SHA-256 hash of the opaque code returned in the redirect.
  codeHash            String      @unique
  oauthClientId       String
  client              OAuthClient @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)
  userId              String
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri         String
  scope               String
  /// PKCE challenge — verifier must hash to this at exchange.
  codeChallenge       String
  /// "S256" only. Plain is rejected.
  codeChallengeMethod String
  expiresAt           DateTime
  usedAt              DateTime?
  createdAt           DateTime    @default(now())

  @@index([oauthClientId, userId])
}

/// Access or refresh token. Opaque value (sent to the client once at
/// issuance) is never stored — only its SHA-256 hash. `revokedAt` is the
/// kill switch for individual tokens or whole-connection revoke.
model OAuthToken {
  id            String         @id @default(cuid())
  tokenHash     String         @unique
  type          OAuthTokenType
  oauthClientId String
  client        OAuthClient    @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope         String
  expiresAt     DateTime
  revokedAt     DateTime?
  lastUsedAt    DateTime?
  /// For a refresh token: the access token issued alongside (so rotation can
  /// revoke both atomically). For an access token: null.
  parentTokenId String?
  createdAt     DateTime       @default(now())

  @@index([oauthClientId, userId])
  @@index([userId, type, revokedAt])
}

/// User-facing record of an active MCP connection. One per (user, client)
/// pair. Surfaced in Settings → Integrations as "Claude is connected" with
/// a last-used timestamp and a Revoke button (which cascades to all tokens).
/// A re-authorization updates the existing row rather than creating a duplicate.
model McpConnection {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthClientId String
  client        OAuthClient @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)
  workspaceId   String
  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Friendly label shown in the UI. Defaults to OAuthClient.clientName.
  label         String
  connectedAt   DateTime    @default(now())
  lastUsedAt    DateTime?
  revokedAt     DateTime?

  @@unique([userId, oauthClientId])
  @@index([workspaceId])
}

/// Generic fixed-window rate-limiter ledger (Postgres-backed, no Redis). One row per
/// counted request, keyed by an opaque `bucket` string (e.g. "onboarding:get:<ip>").
/// `assertWithinRateLimit()` counts recent rows in a bucket and prunes stale ones.
/// Additive, self-contained — no relations, so rows survive their subject's deletion.
model RateLimitHit {
  id        String   @id @default(cuid())
  bucket    String
  createdAt DateTime @default(now())

  @@index([bucket, createdAt])
}

// ─── DevSignal ───────────────────────────────────────────────────────────────
// Developer vetting engine. A NEW pipeline layer that feeds vetted developers
// into Code — it does NOT replace the legacy CodeClear* models (those are the
// existing Code roster and stay untouched). An assessment orchestrates the
// 8-stage funnel, snapshots the config it ran under, and produces one
// explainable 0–100 score. Nothing here promotes a candidate into Code
// automatically — only a human decision (decision = APPROVED_FOR_CODE) can.

enum DevSignalAssessmentStatus {
  DRAFT
  RUNNING
  PENDING_HUMAN
  COMPLETED
  FAILED
  ARCHIVED
}

enum DevSignalDecision {
  NONE
  APPROVED_FOR_STAGING
  REJECTED
  NEEDS_MORE_INFO
  APPROVED_FOR_CODE
}

enum DevSignalStageStatus {
  PENDING
  RUNNING
  PASS
  FAIL
  WARN
  SKIPPED
  PENDING_HUMAN
  ERROR
}

model DevSignalAssessment {
  id               String                    @id @default(cuid())
  workspaceId      String
  workspace        Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Optional client the assessment is scoped to (per-client pipeline config).
  clientId         String?
  client           WorkspaceClient?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  candidateId      String
  candidate        Candidate                 @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  pipelineVersion  String
  configVersion    String
  /// Frozen copy of the pipeline config at assessment time — historical scores
  /// stay interpretable after the live config's weights change.
  configSnapshot   Json
  status           DevSignalAssessmentStatus @default(DRAFT)
  /// Invite-only front door: admin mints a token, candidate uses /vet/[token].
  publicToken      String?                   @unique
  tokenExpiresAt   DateTime?
  startedAt        DateTime?
  finishedAt       DateTime?
  /// Internal 0–100 score. Client-facing views show bestMatchSummary instead.
  finalScore       Int?
  scoreBreakdown   Json?
  bestMatchSummary Json?
  flags            Json?
  decision         DevSignalDecision         @default(NONE)
  decisionBy       String?
  decisionAt       DateTime?
  decisionReason   String?
  /// Only ever set true by an explicit human promotion action.
  promotedToCode   Boolean                   @default(false)
  promotedToCodeBy String?
  promotedToCodeAt DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  stageResults DevSignalStageResult[]
  outcomeLinks DevSignalOutcomeLink[]
  auditEvents  DevSignalAuditEvent[]

  @@index([workspaceId, status])
  @@index([workspaceId, decision])
  @@index([candidateId, createdAt])
  @@index([clientId])
}

model DevSignalStageResult {
  id             String               @id @default(cuid())
  assessmentId   String
  assessment     DevSignalAssessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  workspaceId    String
  candidateId    String
  /// Stage identifier (see DevSignalStageId union in server code).
  stageId        String
  stageName      String
  stageVersion   String
  status         DevSignalStageStatus @default(PENDING)
  weight         Int                  @default(0)
  subScores      Json?
  rawSignals     Json?
  evidence       Json?
  flags          Json?
  durationMs     Int?
  startedAt      DateTime?
  finishedAt     DateTime?
  humanOverride  Boolean              @default(false)
  overrideBy     String?
  overrideAt     DateTime?
  overrideReason String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  /// One row per stage per assessment — re-running a stage upserts (idempotent).
  @@unique([assessmentId, stageId])
  @@index([workspaceId])
  @@index([candidateId])
}

model DevSignalPipelineConfig {
  id                  String           @id @default(cuid())
  workspaceId         String
  workspace           Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId            String?
  client              WorkspaceClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  name                String
  version             String
  isDefault           Boolean          @default(false)
  enabledStages       Json
  stageOrder          Json
  stageWeights        Json
  thresholds          Json?
  blockingRules       Json?
  advisoryRules       Json?
  retentionRules      Json?
  notificationTargets Json?
  createdBy           String?
  publishedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([workspaceId, name, version])
  @@index([workspaceId, isDefault])
  @@index([clientId])
}

model DevSignalOutcomeLink {
  id              String              @id @default(cuid())
  workspaceId     String
  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assessmentId    String
  assessment      DevSignalAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  candidateId     String
  /// Links an intake score to a real delivery placement — the future training
  /// label. We capture it now; recalibration is deliberately NOT built yet.
  placementId     String?
  placement       Placement?          @relation(fields: [placementId], references: [id], onDelete: SetNull)
  deliveryMetrics Json?
  linkedAt        DateTime?
  source          String?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([workspaceId])
  @@index([assessmentId])
  @@index([candidateId])
  @@index([placementId])
}

model DevSignalAuditEvent {
  id           String               @id @default(cuid())
  workspaceId  String
  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assessmentId String?
  assessment   DevSignalAssessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  candidateId  String?
  actorId      String?
  eventType    String
  eventPayload Json?
  createdAt    DateTime             @default(now())

  @@index([workspaceId, createdAt])
  @@index([assessmentId, createdAt])
}
