# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# vendored apps build with their own deps (see vendor/bento/README.md). The
# BUILT shell is committed (public/deck/index.html) — the deps never are.
vendor/**/node_modules
vendor/**/dist
vendor/**/dist-single
vendor/**/*.tsbuildinfo
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-local/
/.next-local*/
/.next.bak.*/
/out/

# production
/build

# misc
.DS_Store
*.pem
.cache/
.* 2
* 2.json
* 2.md
* 2.mts
* 2.ts
* 2.tsx
* 2.tsbuildinfo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets stay local, example is safe to commit)
.env
.env.*
!.env.example

# local MCP config (contains personal access tokens)
.mcp.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
