# Before pushing to `main`: run the quality gate.
#
# WHY ONLY main. Per CLAUDE.md §2, small fixes may be committed straight to `main`, and `main`
# auto-deploys to the VPS. CI does run on a push to `main` — but it runs *in parallel* with
# `deploy.yml`, so a failing check never stops the change reaching production, it only tells you
# afterwards. On the PR path CI reports before you merge, so a feature branch needs no local gate
# and stays fast to push. This hook closes that one gap and nothing else.
#
# Git passes each ref being pushed on stdin as: <local ref> <local sha> <remote ref> <remote sha>
# Escape hatch: `git push --no-verify` (and see the note if you use it on main).

pushing_to_main=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main) pushing_to_main=1 ;;
  esac
done

[ "$pushing_to_main" = "1" ] || exit 0

echo "▸ Pushing to main — running the quality gate (npm run verify)."
echo "  Bypass with 'git push --no-verify' if you know what you're doing."

if [ ! -d node_modules ]; then
  echo ""
  echo "✗ node_modules is missing, so the gate can't run. Do this first:"
  echo "    npm install"
  echo ""
  echo "  Refusing the push rather than letting it through unchecked — a push to main"
  echo "  deploys straight to production."
  exit 1
fi

if ! npm run verify; then
  echo ""
  echo "✗ npm run verify FAILED — push to main refused."
  echo ""
  echo "  main deploys straight to production, and CI runs alongside the deploy rather"
  echo "  than before it, so this is the only thing standing between a broken change and"
  echo "  foundry.gitwork.co.uk. Fix it, or open a PR instead so CI can report first."
  echo "  See docs/build-checklist.md."
  exit 1
fi

echo "▸ Gate passed — pushing to main."
