{
  "name": "foundry-by-gitwork",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && (prisma db push || echo 'DB push skipped — set DATABASE_URL + DIRECT_URL in Vercel') && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "deck:install": "npm --prefix vendor/bento/slides ci",
    "deck:dev": "npm --prefix vendor/bento/slides run dev",
    "deck:build": "npm --prefix vendor/bento/slides run build:foundry",
    "deck:verify": "node vendor/bento/scripts/verify-shell.mjs",
    "audit:clipping": "node scripts/audit-clipping.mjs",
    "audit:ui": "node scripts/audit-ui-standards.mjs",
    "verify": "npm run db:generate && npx tsc --noEmit && npm run lint && npm test && npm run audit:ui -- --self-test && npm run audit:ui",
    "proof:setup": "node scripts/proof-setup.mjs",
    "proof:run": "node scripts/proof-run.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.85.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@docuseal/react": "^1.0.75",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@prisma/client": "^6.19.3",
    "@sparticuz/chromium": "^149.0.0",
    "@swc/helpers": "^0.5.19",
    "@tanstack/react-query": "^5.90.21",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/web-push": "^3.6.4",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "browser-image-compression": "^2.0.2",
    "browserslist": "^4.28.1",
    "caniuse-lite": "^1.0.30001780",
    "clsx": "^2.1.1",
    "date-holidays": "^3.30.2",
    "fflate": "^0.8.3",
    "firebase-admin": "^14.0.0",
    "framer-motion": "^12.0.0",
    "googleapis": "^172.0.0",
    "html-to-image": "^1.11.13",
    "imapflow": "^1.4.7",
    "mailparser": "^3.9.14",
    "next": "^15.5.13",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^7.0.13",
    "openai": "^6.38.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "1.1.1",
    "prosemirror-markdown": "^1.13.5",
    "puppeteer-core": "^25.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.13",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "prisma": "^6.16.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
