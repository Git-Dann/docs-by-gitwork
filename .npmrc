engine-strict=true
# NextAuth beta.32 caps its optional Nodemailer peer at v8, but every v8 release is
# affected by GHSA-p6gq-j5cr-w38f — and every v9 release up to 9.1.0 is affected by the
# resolveContent()/IDN advisories, so the runtime is now v10. NextAuth never constructs a
# transport here (Foundry's only nodemailer call sites are `createTransport` in
# src/server/smtp.ts, support-channels/imap.ts and the test-imap route), so the peer is
# optional in fact as well as in name. Revisit when NextAuth widens its range.
legacy-peer-deps=true
