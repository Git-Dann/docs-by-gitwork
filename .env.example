# ─── Main database (Supabase — docs-by-gitwork project) ──────────────────────
#
# DATABASE_URL  →  Transaction pooler  (used by the app at runtime on Vercel)
#   Supabase dashboard → Settings → Database → Connection pooling
#   Select "Transaction" mode, copy the URI, replace [YOUR-PASSWORD]
DATABASE_URL="postgresql://postgres.fpfdbpjfzjxztwrdktmi:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# DIRECT_URL  →  Direct connection  (used by Prisma for schema migrations/push)
#   Supabase dashboard → Settings → Database → Connection string → URI tab
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.fpfdbpjfzjxztwrdktmi.supabase.co:5432/postgres"

# ─── AI ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ─── GitHub (Pulse repo scans) ───────────────────────────────────────────────
