# ─── Main database (Neon — Foundry by Gitwork project) ───────────────────────
#
# DATABASE_URL  →  Pooled connection  (used by the app at runtime on Vercel)
#   Neon dashboard → Connection Details → Connection string → Pooled connection
#   The pooled host has "-pooler" in the endpoint name
DATABASE_URL="postgresql://[USER]:[PASSWORD]@ep-[NAME]-pooler.[REGION].aws.neon.tech/[DBNAME]?sslmode=require"

# DIRECT_URL  →  Direct connection  (used by Prisma for schema migrations/push)
#   Neon dashboard → Connection Details → Connection string → Direct connection
DIRECT_URL="postgresql://[USER]:[PASSWORD]@ep-[NAME].[REGION].aws.neon.tech/[DBNAME]?sslmode=require"

# ─── Auth (NextAuth.js v5) ───────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# ─── First-run bootstrap ─────────────────────────────────────────────────────
# Set these once to create the first admin account on first deploy, then remove.
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""

# ─── API key (for external/programmatic access to the REST API) ──────────────
# Also configurable in Settings → Developer. Set to gate all /api/ routes.
API_KEY=""

# ─── AI ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ─── GitHub (Pulse repo scans) ───────────────────────────────────────────────
# Personal access token — needs: repo (read), metadata (read)
GITHUB_TOKEN=""

# ─── Cloudflare Turnstile (public Pulse embed spam protection) ───────────────
# Cloudflare dashboard → Turnstile → Add widget (mode: Managed), allow-listing
# gitwork.co.uk / www.gitwork.co.uk / foundry.gitwork.co.uk. Protects the
# no-auth /embed/pulse scan + unlock endpoints. If unset, verification fails
# open (logs a warning) so local dev works without real keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ─── DocuSeal API Integration ──────────────────────────────────────────────
# API key from DocuSeal dashboard (Settings -> API). If blank, uses mock tokens for local testing.
DOCUSEAL_API_KEY=""
# DocuSeal API URL (defaults to https://api.docuseal.com or your self-hosted instance)
DOCUSEAL_URL="https://api.docuseal.com"
# Optional pre-created Template ID from DocuSeal dashboard. If left empty, templates are created dynamically on-the-fly via API.
DOCUSEAL_TEMPLATE_ID=""
# Optional webhook secret for HMAC-SHA256 signature verification of inbound DocuSeal webhook events.
# Set this in DocuSeal dashboard → Webhooks → Secret. When set, the X-Docuseal-Signature header is
# validated on every inbound event. When absent, a warning is logged and requests are accepted anyway
# (so local dev works without configuration).
DOCUSEAL_WEBHOOK_SECRET=""



