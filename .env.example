# ─── Main database (Neon — Foundry by Gitwork project) ───────────────────────
#
# DATABASE_URL  →  Pooled connection  (used by the app at runtime on Vercel)
#   Neon dashboard → Connection Details → Connection string → Pooled connection
#   The pooled host has "-pooler" in the endpoint name
DATABASE_URL="postgresql://[USER]:[PASSWORD]@ep-[NAME]-pooler.[REGION].aws.neon.tech/[DBNAME]?sslmode=require"

# DIRECT_URL  →  Direct connection  (used by Prisma for schema migrations/push)
#   Neon dashboard → Connection Details → Connection string → Direct connection
DIRECT_URL="postgresql://[USER]:[PASSWORD]@ep-[NAME].[REGION].aws.neon.tech/[DBNAME]?sslmode=require"

# ─── Auth (NextAuth.js v5) ───────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# ─── First-run bootstrap ─────────────────────────────────────────────────────
# Set these once to create the first admin account on first deploy, then remove.
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""

# ─── API key (for external/programmatic access to the REST API) ──────────────
# Also configurable in Settings → Developer. Set to gate all /api/ routes.
API_KEY=""

# ─── AI ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ─── GitHub (Pulse repo scans) ───────────────────────────────────────────────
# Personal access token — needs: repo (read), metadata (read)
GITHUB_TOKEN=""
